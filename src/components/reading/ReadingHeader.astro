---
import { getTagColorClasses, getTagName } from '../../utils/tags'

interface Props {
  totalArticles: number
  tagCounts: Map<string, number>
  activeTag?: string
  filteredCount?: number
}

const { totalArticles, tagCounts, activeTag, filteredCount } = Astro.props
const sortedTags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1])
const isFiltered = !!activeTag
---

<div class="mb-10">
  <header class="pt-8 pb-8 border-b" style="border-color: var(--color-outline-variant);" data-entrance>
    <h1>Reading list</h1>
    <p class="mt-3 text-lg text-on-surface-variant leading-normal">
      {isFiltered ? (
        <span>{filteredCount} of {totalArticles} articles saved on <a href="https://www.instapaper.com/p/russmckendrick" class="underline" target="_blank" rel="noopener noreferrer">Instapaper</a></span>
      ) : (
        <span>{totalArticles} articles saved on <a href="https://www.instapaper.com/p/russmckendrick" class="underline" target="_blank" rel="noopener noreferrer">Instapaper</a></span>
      )}
    </p>
  </header>

  {sortedTags.length > 0 && (
    <div class="mt-6 flex flex-wrap items-center gap-2">
      <span class="rubric mr-1">Filter:</span>
      <a
        href="/reading/"
        class:list={["reading-tag-btn", getTagColorClasses(), { active: !isFiltered }]}
      >
        All
      </a>
      {sortedTags.map(([tag, count]) => (
        <a
          href={`/reading/tag/${encodeURIComponent(tag)}/`}
          class:list={["reading-tag-btn", getTagColorClasses(tag), { active: activeTag === tag }]}
        >
          {getTagName(tag)}
          <span class="opacity-60">({count})</span>
        </a>
      ))}
    </div>
  )}
</div>

<style>
  .reading-tag-btn.active {
    color: var(--color-secondary);
    background-color: var(--pill-hover);
  }
</style>
