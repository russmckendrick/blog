---
import { getReadingPreviewImage, getReadingPreviewSrcSet, getReadingPreviewData } from '../../utils/reading-preview'
import { getTagColorClasses, getTagName } from '../../utils/tags'

interface ReadingItem {
  bookmark_id: number
  title: string
  url: string
  description: string
  time: string
  starred: boolean
  progress: number
  tags: string[]
  folder: string
}

interface Props {
  items: ReadingItem[]
}

const { items } = Astro.props

// Group items by month/year
const grouped = items.reduce((acc, item) => {
  const date = new Date(item.time)
  const key = `${date.toLocaleString('en-GB', { month: 'long' })} ${date.getFullYear()}`
  if (!acc.has(key)) acc.set(key, [])
  acc.get(key)!.push(item)
  return acc
}, new Map<string, ReadingItem[]>())

function getDomain(url: string): string {
  try {
    return new URL(url).hostname.replace(/^www\./, '')
  } catch {
    return ''
  }
}

function getFaviconUrl(url: string): string {
  try {
    const hostname = new URL(url).hostname
    return `https://www.google.com/s2/favicons?domain=${hostname}&sz=32`
  } catch {
    return ''
  }
}

function formatDate(iso: string): string {
  return new Date(iso).toLocaleDateString('en-GB', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
  })
}
---

{items.length === 0 ? (
  <p class="text-on-surface-variant text-lg py-12">
    No articles yet. Run <code class="text-sm">node scripts/fetch-reading-list.js</code> to populate.
  </p>
) : (
  <div class="space-y-12">
    {[...grouped.entries()].map(([monthYear, monthItems]) => (
      <div data-reveal data-month-group>
        <div class="flex items-baseline gap-3">
          <h2 class="text-[15px] text-on-surface" style="font-weight: 600; letter-spacing: -0.01em;">{monthYear}</h2>
          <span class="rubric">{monthItems.length}&nbsp;{monthItems.length === 1 ? 'article' : 'articles'}</span>
        </div>
        <div>
          {monthItems.map((item) => {
            const ogImage = getReadingPreviewImage(item.url)
            const ogSrcSet = getReadingPreviewSrcSet(item.url)
            const previewData = getReadingPreviewData(item.url)
            const description = previewData?.description || ''

            return (
              <a
                href={item.url}
                target="_blank"
                rel="noopener noreferrer"
                data-reading-tags={item.tags.join(',')}
                class="group block no-underline focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-4"
              >
                <article class="flex items-start gap-5 sm:gap-10 border-b py-6" style="border-color: var(--color-outline-variant);">
                  <div class="flex-1 min-w-0 flex flex-col gap-2">
                    <h3
                      class="font-display text-lg text-on-surface leading-[1.3] line-clamp-2 transition-colors group-hover:text-[var(--color-secondary)]"
                      style="font-weight: 700; letter-spacing: -0.014em;"
                    >
                      {item.title}
                    </h3>
                    {description && (
                      <p class="hidden sm:line-clamp-2 text-base text-on-surface-variant leading-normal">{description}</p>
                    )}
                    <p class="rubric mt-1.5 flex flex-wrap items-center gap-x-1.5 gap-y-2">
                      <img
                        src={getFaviconUrl(item.url)}
                        alt=""
                        width="16"
                        height="16"
                        loading="lazy"
                        class="w-4 h-4 rounded-[3px] opacity-70 group-hover:opacity-100 transition-opacity"
                      />
                      <span class="truncate max-w-[12rem]">{getDomain(item.url)}</span>
                      <span aria-hidden="true">&middot;</span>
                      <span>{formatDate(item.time)}</span>
                      {item.tags.length > 0 && item.tags.map(tag => (
                        <span class={getTagColorClasses(tag)}>{getTagName(tag)}</span>
                      ))}
                    </p>
                  </div>
                  {ogImage && (
                    <figure class="relative overflow-hidden rounded-[3px] flex-none w-[100px] h-[56px] sm:w-40 sm:h-[90px] mt-1">
                      <img
                        src={ogImage}
                        srcset={ogSrcSet || undefined}
                        sizes="(min-width: 640px) 160px, 100px"
                        alt=""
                        width="160"
                        height="90"
                        loading="lazy"
                        decoding="async"
                        class="w-full h-full object-cover"
                      />
                    </figure>
                  )}
                </article>
              </a>
            )
          })}
        </div>
      </div>
    ))}
  </div>
)}
