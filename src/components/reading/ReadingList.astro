---
import { getReadingPreviewImage, getReadingPreviewSrcSet, getReadingPreviewData } from '../../utils/reading-preview'
import { getTagName } from '../../utils/tags'

interface ReadingItem {
  bookmark_id: number
  title: string
  url: string
  description: string
  time: string
  starred: boolean
  progress: number
  tags: string[]
  folder: string
}

interface Props {
  items: ReadingItem[]
}

const { items } = Astro.props

// Group items by month/year
const grouped = items.reduce((acc, item) => {
  const date = new Date(item.time)
  const key = `${date.toLocaleString('en-GB', { month: 'long' })} ${date.getFullYear()}`
  if (!acc.has(key)) acc.set(key, [])
  acc.get(key)!.push(item)
  return acc
}, new Map<string, ReadingItem[]>())

// The first row of cards sits above the fold, so those previews load
// eagerly (one is usually the LCP element); everything after stays lazy.
const eagerIds = new Set(items.slice(0, 3).map((item) => item.bookmark_id))

function getDomain(url: string): string {
  try {
    return new URL(url).hostname.replace(/^www\./, '')
  } catch {
    return ''
  }
}

function getFaviconUrl(url: string): string {
  try {
    const hostname = new URL(url).hostname
    return `https://www.google.com/s2/favicons?domain=${hostname}&sz=64`
  } catch {
    return ''
  }
}

function formatDate(iso: string): string {
  return new Date(iso).toLocaleDateString('en-GB', {
    day: 'numeric',
    month: 'short',
  })
}
---

{items.length === 0 ? (
  <p class="text-on-surface-variant text-lg py-12">
    No articles yet. Run <code class="text-sm">node scripts/fetch-reading-list.js</code> to populate.
  </p>
) : (
  <div class="reading-months">
    {[...grouped.entries()].map(([monthYear, monthItems]) => (
      <section data-month-group aria-label={monthYear}>
        <div class="reading-month-head">
          <h2 class="reading-month-title">{monthYear}</h2>
          <span class="rubric">{monthItems.length}&nbsp;{monthItems.length === 1 ? 'article' : 'articles'}</span>
        </div>
        <ul class="reading-grid" role="list">
          {monthItems.map((item) => {
            const ogImage = getReadingPreviewImage(item.url)
            const ogSrcSet = getReadingPreviewSrcSet(item.url)
            const previewData = getReadingPreviewData(item.url)
            const description = previewData?.description || item.description || ''
            const domain = getDomain(item.url)
            const eager = eagerIds.has(item.bookmark_id)

            return (
              <li data-reveal>
                <a
                  href={item.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-reading-tags={item.tags.join(',')}
                  class="reading-card"
                >
                  {ogImage ? (
                    <img
                      src={ogImage}
                      srcset={ogSrcSet || undefined}
                      sizes="(min-width: 1320px) 392px, (min-width: 1024px) calc((100vw - 144px) / 3), (min-width: 640px) calc((100vw - 80px) / 2), calc(100vw - 32px)"
                      alt=""
                      width="640"
                      height="336"
                      loading={eager ? 'eager' : 'lazy'}
                      fetchpriority={eager ? 'high' : 'auto'}
                      decoding="async"
                      class="reading-card-image"
                    />
                  ) : (
                    <span class="reading-card-image reading-card-image--blank" aria-hidden="true">
                      <img src={getFaviconUrl(item.url)} alt="" width="32" height="32" loading="lazy" />
                      <span>{domain}</span>
                    </span>
                  )}
                  <span class="reading-card-meta rubric">
                    <img src={getFaviconUrl(item.url)} alt="" width="16" height="16" loading="lazy" class="reading-card-favicon" />
                    <span class="truncate">{domain}</span>
                    <span aria-hidden="true">&middot;</span>
                    <span class="flex-none">{formatDate(item.time)}</span>
                  </span>
                  <span class="reading-card-title">{item.title}</span>
                  {description && <span class="reading-card-desc">{description}</span>}
                  {item.tags.length > 0 && (
                    <span class="reading-card-tags">
                      {item.tags.map((tag) => <span>{getTagName(tag)}</span>)}
                    </span>
                  )}
                </a>
              </li>
            )
          })}
        </ul>
      </section>
    ))}
  </div>
)}

<style>
  .reading-months {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
    padding-top: 2.5rem;
  }

  .reading-month-head {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .reading-month-title {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.025em;
  }

  .reading-grid {
    display: grid;
    gap: 2.5rem 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 640px) {
    .reading-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .reading-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .reading-card {
    display: flex;
    flex-direction: column;
    color: var(--color-on-surface);
    text-decoration: none;
  }

  .reading-card:hover {
    color: var(--color-on-surface);
  }

  .reading-card-image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1200 / 630;
    object-fit: cover;
    border-radius: 14px;
    background-color: var(--paper-well);
  }

  .reading-card-image--blank {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    color: var(--color-on-surface-variant);
    font-size: 0.875rem;
    font-weight: 500;
  }

  .reading-card-image--blank img {
    width: 32px;
    height: 32px;
    border-radius: 6px;
  }

  .reading-card-meta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    min-width: 0;
    margin-top: 1rem;
  }

  .reading-card-favicon {
    flex: none;
    width: 16px;
    height: 16px;
    border-radius: 3px;
  }

  .reading-card-title {
    margin-top: 0.5rem;
    font-size: 1.125rem;
    line-height: 1.3;
    font-weight: 700;
    letter-spacing: -0.015em;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color var(--dur-quick) ease;
  }

  .reading-card:hover .reading-card-title {
    color: var(--accent);
  }

  .reading-card-desc {
    margin-top: 0.5rem;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--color-on-surface-variant);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .reading-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: 0.75rem;
  }

  .reading-card-tags span {
    padding: 0.2rem 0.6rem;
    border-radius: 9999px;
    background-color: var(--paper-well);
    font-size: 0.75rem;
    color: var(--color-on-surface-variant);
  }
</style>
