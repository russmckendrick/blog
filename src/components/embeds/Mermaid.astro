---
interface Props {
  /** The Mermaid diagram code */
  code: string;
  /** Optional title for accessibility */
  title?: string;
  /** Minimap position: TL (top-left), TR (top-right), BL (bottom-left), BR (bottom-right), off (disabled) */
  minimapPosition?: 'TL' | 'TR' | 'BL' | 'BR' | 'off';
}

const { code, title = "Mermaid diagram", minimapPosition = "BR" } = Astro.props;
const diagramId = `mermaid-${Math.random().toString(36).substring(2, 9)}`;

// Calculate minimap position classes
const positionClasses = {
  TL: 'top-3 left-3',
  TR: 'top-3 right-3',
  BL: 'bottom-3 left-3',
  BR: 'bottom-3 right-3',
  off: 'hidden'
};
const minimapPositionClass = positionClasses[minimapPosition];
---

<div class="mermaid-wrapper not-prose my-6" data-diagram-id={diagramId} data-diagram-title={title}>
  <!-- Controls bar -->
  <div class="mermaid-bar">
    <div class="flex items-center gap-3 min-w-0">
      {title && title !== "Mermaid diagram" && (
        <span class="mermaid-title">{title}</span>
      )}
    </div>
    <div class="flex items-center gap-1">
      <span class="mermaid-hint hidden sm:inline" title="Hold Ctrl (or Cmd on Mac) and scroll to zoom">Ctrl+scroll to zoom</span>
      <button
        class="mermaid-btn fullscreen-btn"
        data-action="fullscreen"
        aria-label="View fullscreen"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3.75v4.5m0-4.5h4.5m-4.5 0L9 9M3.75 20.25v-4.5m0 4.5h4.5m-4.5 0L9 15M20.25 3.75h-4.5m4.5 0v4.5m0-4.5L15 9m5.25 11.25h-4.5m4.5 0v-4.5m0 4.5L15 15" />
        </svg>
        <span class="hidden sm:inline">Fullscreen</span>
      </button>
      <button
        class="mermaid-btn export-svg-btn"
        data-action="export-svg"
        aria-label="Export as SVG"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" />
        </svg>
        <span class="hidden sm:inline">SVG</span>
      </button>
      <button
        class="mermaid-btn export-png-btn"
        data-action="export-png"
        aria-label="Export as PNG"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909M3.75 21h16.5A2.25 2.25 0 0 0 22.5 18.75V5.25A2.25 2.25 0 0 0 20.25 3H3.75A2.25 2.25 0 0 0 1.5 5.25v13.5A2.25 2.25 0 0 0 3.75 21Z" />
        </svg>
        <span class="hidden sm:inline">PNG</span>
      </button>
    </div>
  </div>

  <!-- Error display -->
  <div class="error-display mermaid-error hidden">
    <p class="mermaid-error-heading">Error rendering diagram:</p>
    <pre></pre>
  </div>

  <!-- Diagram container -->
  <div
    class="preview-container relative overflow-hidden"
    role="img"
    aria-label={title}
  >
    <div class="svg-wrap flex items-center justify-center" style="transform-origin: center center; min-height: 200px;"></div>

    <!-- Minimap overlay -->
    <div class={`minimap-container absolute ${minimapPositionClass} overflow-hidden`} style="width: 140px; height: 105px;">
      <div class="minimap-canvas relative" style="width: 100%; height: 100%;"></div>
      <div class="minimap-viewport absolute cursor-move" style="pointer-events: auto;"></div>
      <div class="minimap-controls absolute top-1 right-1 flex flex-col gap-0.5">
        <button
          class="minimap-zoom-in"
          data-action="zoom-in"
          aria-label="Zoom in"
        >
          <span class="zoom-icon">+</span>
        </button>
        <button
          class="minimap-zoom-out"
          data-action="zoom-out"
          aria-label="Zoom out"
        >
          <span class="zoom-icon">−</span>
        </button>
        <button
          class="minimap-reset"
          data-action="reset"
          aria-label="Reset view"
        >
          <span class="zoom-icon text-[10px]">⟲</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Store diagram code in data attribute -->
  <script is:inline type="application/json" class="diagram-code" set:html={JSON.stringify(code)}></script>
</div>

<script>
  // This script runs once when the module is loaded
  import mermaid from 'mermaid';
  import { exportMermaidPNG } from '../../utils/exportMermaidPNG';

  type DiagramTheme = 'light' | 'dark';

  // Workbench tokens (DESIGN.md). Mermaid derives shades from these with its
  // own colour maths, so they have to be literal hex rather than CSS vars.
  const PALETTES = {
    light: {
      page: '#ffffff',
      tint: '#f4f4f5',
      ink: '#0b0b0c',
      mist: '#5e5e66',
      rule: '#e6e6e9',
      ruleStrong: '#d4d4d8',
      accent: { fill: '#fcf0da', stroke: '#f2b544' },
      ok: { fill: '#e4e8e2', stroke: '#3d5c33' },
      error: { fill: '#f2e6e0', stroke: '#8f2d00' }
    },
    dark: {
      page: '#0b0b0c',
      tint: '#151517',
      ink: '#ededef',
      mist: '#a1a1a6',
      rule: '#26262a',
      ruleStrong: '#333338',
      accent: { fill: '#352a16', stroke: '#f2b544' },
      ok: { fill: '#20241e', stroke: '#a4bd8c' },
      error: { fill: '#2a201e', stroke: '#e5a48c' }
    }
  };

  // The Astro font pipeline generates the Geist family name, so read it back
  // from the page rather than hard-coding it.
  function diagramFont() {
    return getComputedStyle(document.body).fontFamily || 'Geist, -apple-system, sans-serif';
  }

  function configFor(theme: DiagramTheme) {
    const p = PALETTES[theme];
    mermaid.initialize({
      startOnLoad: false,
      theme: 'base',
      look: 'neo',
      themeVariables: {
        darkMode: theme === 'dark',
        fontFamily: diagramFont(),
        fontSize: '14px',
        background: p.page,
        primaryColor: p.tint,
        primaryTextColor: p.ink,
        primaryBorderColor: p.ruleStrong,
        secondaryColor: p.tint,
        tertiaryColor: p.page,
        mainBkg: p.tint,
        nodeBorder: p.ruleStrong,
        nodeTextColor: p.ink,
        textColor: p.ink,
        titleColor: p.ink,
        lineColor: p.mist,
        clusterBkg: p.page,
        clusterBorder: p.rule,
        edgeLabelBackground: p.page,
        labelBackgroundColor: p.page,
        stateBkg: p.tint,
        stateLabelColor: p.ink,
        transitionColor: p.mist,
        compositeBackground: p.page,
        noteBkgColor: p.accent.fill,
        noteBorderColor: p.accent.stroke,
        noteTextColor: p.ink,
        errorBkgColor: p.error.fill,
        errorTextColor: p.ink,
        radius: 8,
        strokeWidth: 1.5,
        dropShadow: 'none',
        useGradient: false
      },
      flowchart: {
        useMaxWidth: true,
        htmlLabels: true,
        curve: 'basis'
      }
    });
  }

  // Posts mark nodes with `class X accent|ok|error`; the classDefs are added
  // here so the colours follow the theme and are baked into exported SVGs.
  function withNodeClasses(diagramCode: string, theme: DiagramTheme) {
    if (!/^\s*(flowchart|graph|stateDiagram)/.test(diagramCode)) return diagramCode;
    const p = PALETTES[theme];
    const defs = (['accent', 'ok', 'error'] as const)
      .map((name) => `classDef ${name} fill:${p[name].fill},stroke:${p[name].stroke},color:${p.ink}`)
      .join('\n');
    return `${diagramCode.trimEnd()}\n${defs}\n`;
  }

  // Mermaid only rounds rect nodes when the diagram asks for it, so give
  // square process boxes the same 8px corners as the rest of the site.
  function roundNodes(svgEl: SVGSVGElement) {
    svgEl.querySelectorAll('.node rect.label-container, .node > rect').forEach((rect) => {
      if (Number(rect.getAttribute('rx') || 0) > 0) return;
      rect.setAttribute('rx', '8');
      rect.setAttribute('ry', '8');
    });
  }

  function roundSvgString(svg: string) {
    const doc = new DOMParser().parseFromString(svg, 'image/svg+xml');
    const svgEl = doc.documentElement as unknown as SVGSVGElement;
    if (svgEl.nodeName !== 'svg') return svg;
    roundNodes(svgEl);
    return new XMLSerializer().serializeToString(svgEl);
  }

  configFor('light');

  // Function to initialize a single diagram wrapper
  function initializeDiagram(wrapper: HTMLElement) {
    // Guard against double-initialization (HMR in dev mode)
    if (wrapper.hasAttribute('data-mermaid-initialized')) return;
    wrapper.setAttribute('data-mermaid-initialized', 'true');

    // Get diagram code from JSON script tag
    const codeScript = wrapper.querySelector('.diagram-code');
    if (!codeScript) {
      console.error('[Mermaid] No diagram code found');
      return;
    }

    const codeText = codeScript.textContent || '""';

    let code: string;
    try {
      code = JSON.parse(codeText);
    } catch (e) {
      console.error('[Mermaid] Failed to parse code JSON:', e);
      return;
    }

    const diagramId = wrapper.getAttribute('data-diagram-id') || 'mermaid-default';
    const diagramTitle = wrapper.getAttribute('data-diagram-title') || '';

    // Diagram state
    let scale = 1;
    let panX = 0;
    let panY = 0;
    let isDragging = false;
    let startX = 0;
    let startY = 0;
    let currentTheme: DiagramTheme = 'light';

    // Get DOM elements
    const previewDiv = wrapper.querySelector('.preview-container') as HTMLElement;
    const svgWrap = wrapper.querySelector('.svg-wrap') as HTMLElement;
    const errorDisplay = wrapper.querySelector('.error-display') as HTMLElement;
    const errorPre = errorDisplay?.querySelector('pre') as HTMLPreElement;
    const minimapContainer = wrapper.querySelector('.minimap-container') as HTMLElement;
    const minimapCanvas = wrapper.querySelector('.minimap-canvas') as HTMLElement;
    const minimapViewport = wrapper.querySelector('.minimap-viewport') as HTMLElement;

    if (!previewDiv || !svgWrap || !errorDisplay || !errorPre || !minimapContainer || !minimapCanvas || !minimapViewport) {
      console.error('Mermaid wrapper elements not found');
      return;
    }

    // Detect current theme
    function detectTheme(): DiagramTheme {
      return document.documentElement.classList.contains('dark') ? 'dark' : 'light';
    }

    // Apply transform to SVG wrapper
    function applyTransform() {
      svgWrap.style.transform = `translate(${panX}px, ${panY}px) scale(${scale})`;
      updateMinimap();
    }

    // Update minimap viewport indicator
    function updateMinimap() {
      const svgEl = svgWrap.querySelector('svg');
      if (!svgEl) return;

      const svgRect = svgEl.getBoundingClientRect();
      const previewRect = previewDiv.getBoundingClientRect();
      const viewBox = svgEl.viewBox.baseVal;

      // Calculate minimap dimensions
      const minimapWidth = minimapCanvas.clientWidth;
      const minimapHeight = minimapCanvas.clientHeight;

      // Calculate visible viewport in SVG coordinates
      const visibleWidth = previewRect.width / scale;
      const visibleHeight = previewRect.height / scale;

      // Calculate viewport position in minimap
      const viewportWidth = (visibleWidth / viewBox.width) * minimapWidth;
      const viewportHeight = (visibleHeight / viewBox.height) * minimapHeight;

      // Calculate center offset (since SVG is centered)
      const svgCenterX = (previewRect.width - svgRect.width) / 2;
      const svgCenterY = (previewRect.height - svgRect.height) / 2;

      // Calculate viewport position accounting for pan and center offset
      const viewportX = ((svgCenterX - panX) / scale / viewBox.width) * minimapWidth;
      const viewportY = ((svgCenterY - panY) / scale / viewBox.height) * minimapHeight;

      // Update viewport indicator
      minimapViewport.style.left = `${Math.max(0, Math.min(viewportX, minimapWidth - viewportWidth))}px`;
      minimapViewport.style.top = `${Math.max(0, Math.min(viewportY, minimapHeight - viewportHeight))}px`;
      minimapViewport.style.width = `${Math.min(viewportWidth, minimapWidth)}px`;
      minimapViewport.style.height = `${Math.min(viewportHeight, minimapHeight)}px`;
    }

    // Render minimap thumbnail
    function renderMinimap() {
      const svgEl = svgWrap.querySelector('svg');
      if (!svgEl) return;

      // Clone the SVG for minimap
      const svgClone = svgEl.cloneNode(true) as SVGSVGElement;
      svgClone.removeAttribute('style');

      const viewBox = svgEl.viewBox.baseVal;

      // Calculate scale to fit minimap
      const minimapWidth = minimapCanvas.clientWidth;
      const minimapHeight = minimapCanvas.clientHeight;
      const scaleX = minimapWidth / viewBox.width;
      const scaleY = minimapHeight / viewBox.height;
      const minimapScale = Math.min(scaleX, scaleY);

      const scaledWidth = viewBox.width * minimapScale;
      const scaledHeight = viewBox.height * minimapScale;

      svgClone.style.width = `${scaledWidth}px`;
      svgClone.style.height = `${scaledHeight}px`;
      svgClone.style.position = 'absolute';
      svgClone.style.left = '50%';
      svgClone.style.top = '50%';
      svgClone.style.transform = 'translate(-50%, -50%)';
      svgClone.style.pointerEvents = 'none';
      svgClone.style.opacity = '0.7';

      // Clear and add minimap SVG
      minimapCanvas.innerHTML = '';
      minimapCanvas.appendChild(svgClone);

      updateMinimap();
    }

    // Render Mermaid diagram
    async function renderMermaid(diagramCode: string) {
      try {
        // Hide error, clear preview
        errorDisplay.classList.add('hidden');
        errorPre.textContent = '';

        // Detect theme and render
        currentTheme = detectTheme();

        configFor(currentTheme);

        // Render the diagram with unique ID
        const renderId = `${diagramId}-${Date.now()}`;
        const renderResult = await mermaid.render(renderId, withNodeClasses(diagramCode, currentTheme));
        const svg = renderResult.svg;

        // Use requestAnimationFrame for DOM manipulation timing
        requestAnimationFrame(() => {
          svgWrap.innerHTML = svg;

          const svgEl = svgWrap.querySelector('svg');
          if (svgEl) {
            roundNodes(svgEl);

            // Store viewBox before modifications
            const viewBox = svgEl.viewBox.baseVal;

            // Critical: Remove fixed dimensions for responsive sizing (Mermaider approach)
            svgEl.removeAttribute('width');
            svgEl.removeAttribute('height');
            svgEl.removeAttribute('style');

            // Calculate responsive sizing based on container width
            const containerWidth = previewDiv.clientWidth;
            const aspectRatio = viewBox.height / viewBox.width;

            // If diagram is wider than container, scale it down
            const displayWidth = Math.min(viewBox.width, containerWidth - 40); // 40px padding
            const displayHeight = displayWidth * aspectRatio;

            // Apply responsive sizing
            svgEl.style.width = `${displayWidth}px`;
            svgEl.style.height = `${displayHeight}px`;
            svgEl.style.maxWidth = '100%';

            // Set the wrapper height to match the SVG with padding
            const wrapperHeight = Math.max(200, displayHeight + 40);
            svgWrap.style.minHeight = `${wrapperHeight}px`;

            // Reset transform
            scale = 1;
            panX = 0;
            panY = 0;
            applyTransform();
            renderMinimap();
          }
        });
      } catch (err: any) {
        // Show error
        const errorMsg = err?.str || err?.message || (typeof err === 'string' ? err : JSON.stringify(err));
        errorDisplay.classList.remove('hidden');
        errorPre.textContent = errorMsg;
        svgWrap.innerHTML = '';
      }
    }

    // Zoom controls
    function handleZoom(direction: 'in' | 'out' | 'reset') {
      if (direction === 'in') {
        scale *= 1.1;
      } else if (direction === 'out') {
        scale *= 0.9;
      } else if (direction === 'reset') {
        scale = 1;
        panX = 0;
        panY = 0;
      }

      // Clamp scale (0.2x to 5x)
      scale = Math.max(0.2, Math.min(scale, 5));

      applyTransform();
    }

    // Mouse wheel zoom (requires Ctrl/Cmd key to zoom, otherwise allows normal scrolling)
    function handleWheel(e: WheelEvent) {
      // Only zoom if Ctrl (Windows/Linux) or Cmd (Mac) is held
      if (!e.ctrlKey && !e.metaKey) {
        return; // Allow normal page scrolling
      }

      e.preventDefault();
      const delta = e.deltaY;

      // Zoom centered on mouse position
      scale *= delta > 0 ? 0.9 : 1.1;
      scale = Math.max(0.2, Math.min(scale, 5));

      applyTransform();
    }

    // Mouse drag pan
    function handleMouseDown(e: MouseEvent) {
      isDragging = true;
      startX = e.clientX - panX;
      startY = e.clientY - panY;
      previewDiv.style.cursor = 'grabbing';
    }

    function handleMouseMove(e: MouseEvent) {
      if (!isDragging) return;
      panX = e.clientX - startX;
      panY = e.clientY - startY;
      applyTransform();
    }

    function handleMouseUp() {
      isDragging = false;
      previewDiv.style.cursor = 'grab';
    }

    // Minimap viewport drag
    let isMinimapDragging = false;
    let minimapStartX = 0;
    let minimapStartY = 0;
    let minimapStartPanX = 0;
    let minimapStartPanY = 0;

    function handleMinimapViewportMouseDown(e: MouseEvent) {
      e.stopPropagation();
      isMinimapDragging = true;
      minimapStartX = e.clientX;
      minimapStartY = e.clientY;
      minimapStartPanX = panX;
      minimapStartPanY = panY;
      minimapViewport.style.cursor = 'grabbing';
    }

    function handleMinimapMouseMove(e: MouseEvent) {
      if (!isMinimapDragging) return;

      const svgEl = svgWrap.querySelector('svg');
      if (!svgEl) return;

      const viewBox = svgEl.viewBox.baseVal;
      const minimapWidth = minimapCanvas.clientWidth;
      const minimapHeight = minimapCanvas.clientHeight;

      // Calculate movement in minimap space
      const deltaX = e.clientX - minimapStartX;
      const deltaY = e.clientY - minimapStartY;

      // Convert to SVG space
      const svgDeltaX = (deltaX / minimapWidth) * viewBox.width * scale;
      const svgDeltaY = (deltaY / minimapHeight) * viewBox.height * scale;

      // Update pan (inverted because we're moving the viewport indicator)
      panX = minimapStartPanX - svgDeltaX;
      panY = minimapStartPanY - svgDeltaY;

      applyTransform();
    }

    function handleMinimapMouseUp() {
      isMinimapDragging = false;
      minimapViewport.style.cursor = 'move';
    }

    // Click on minimap to jump to that position
    function handleMinimapClick(e: MouseEvent) {
      if (e.target !== minimapCanvas && e.target !== (minimapCanvas.querySelector('svg'))) return;

      const svgEl = svgWrap.querySelector('svg');
      if (!svgEl) return;

      const viewBox = svgEl.viewBox.baseVal;
      const minimapRect = minimapCanvas.getBoundingClientRect();

      // Calculate click position relative to minimap
      const clickX = e.clientX - minimapRect.left;
      const clickY = e.clientY - minimapRect.top;

      // Convert to SVG coordinates
      const svgX = (clickX / minimapRect.width) * viewBox.width;
      const svgY = (clickY / minimapRect.height) * viewBox.height;

      // Calculate new pan to center on click position
      const previewRect = previewDiv.getBoundingClientRect();
      const centerX = previewRect.width / 2;
      const centerY = previewRect.height / 2;

      panX = centerX - (svgX * scale);
      panY = centerY - (svgY * scale);

      applyTransform();
    }

    // Get light mode version of SVG for export
    async function getLightModeSVG() {
      configFor('light');

      const renderResult = await mermaid.render(`${diagramId}-export-${Date.now()}`, withNodeClasses(code, 'light'));
      return roundSvgString(renderResult.svg);
    }

    // Export to PNG (always light mode)
    async function handleExportPNG() {
      try {
        const lightSvg = await getLightModeSVG();

        // Create temporary container
        const tempDiv = document.createElement('div');
        tempDiv.innerHTML = lightSvg;
        tempDiv.style.position = 'absolute';
        tempDiv.style.left = '-9999px';
        document.body.appendChild(tempDiv);

        const svgEl = tempDiv.querySelector('svg') as SVGSVGElement;
        if (svgEl) {
          const filename = diagramTitle && diagramTitle !== 'Mermaid diagram'
            ? `${diagramTitle.replace(/[^a-z0-9]/gi, '_').toLowerCase()}.png`
            : `${diagramId}.png`;
          exportMermaidPNG(svgEl, filename);
        }

        // Cleanup
        document.body.removeChild(tempDiv);

        // Re-render current theme
        renderMermaid(code);
      } catch (err) {
        console.error('Export PNG failed:', err);
      }
    }

    // Export to SVG (always light mode)
    async function handleExportSVG() {
      try {
        const lightSvg = await getLightModeSVG();

        // Create blob and download
        const blob = new Blob([lightSvg], { type: 'image/svg+xml' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = diagramTitle && diagramTitle !== 'Mermaid diagram'
          ? `${diagramTitle.replace(/[^a-z0-9]/gi, '_').toLowerCase()}.svg`
          : `${diagramId}.svg`;
        a.click();
        URL.revokeObjectURL(url);

        // Re-render current theme
        renderMermaid(code);
      } catch (err) {
        console.error('Export SVG failed:', err);
      }
    }

    // Fullscreen overlay
    function handleFullscreen() {
      const svgEl = svgWrap.querySelector('svg');
      if (!svgEl) return;

      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Create overlay - all styles inline so they work when appended to body
      const overlay = document.createElement('div');
      Object.assign(overlay.style, {
        position: 'fixed',
        inset: '0',
        zIndex: '99998',
        display: 'flex',
        flexDirection: 'column',
        background: 'rgba(0, 0, 0, 0.95)',
        opacity: '0',
        transition: reducedMotion ? 'none' : 'opacity 0.3s cubic-bezier(0.22, 0.61, 0.36, 1)',
      });

      // Header bar
      const header = document.createElement('div');
      Object.assign(header.style, {
        display: 'flex',
        alignItems: 'center',
        justifyContent: 'space-between',
        padding: '0.75rem 1.25rem',
        background: 'rgba(255, 255, 255, 0.06)',
        borderBottom: '1px solid rgba(255, 255, 255, 0.1)',
        flexShrink: '0',
      });

      const titleEl = document.createElement('span');
      Object.assign(titleEl.style, {
        fontSize: '0.875rem',
        fontWeight: '500',
        color: 'rgba(255, 255, 255, 0.9)',
        letterSpacing: '0.01em',
      });
      titleEl.textContent = diagramTitle && diagramTitle !== 'Mermaid diagram' ? diagramTitle : 'Diagram';

      const controls = document.createElement('div');
      Object.assign(controls.style, {
        display: 'flex',
        alignItems: 'center',
        gap: '0.25rem',
      });

      // Shared button style helper
      function styleBtn(btn: HTMLElement) {
        Object.assign(btn.style, {
          display: 'flex',
          alignItems: 'center',
          justifyContent: 'center',
          width: '2rem',
          height: '2rem',
          borderRadius: '0.375rem',
          border: 'none',
          background: 'transparent',
          color: 'rgba(255, 255, 255, 0.7)',
          cursor: 'pointer',
          transition: 'background-color 0.15s ease, color 0.15s ease',
        });
        btn.addEventListener('mouseenter', () => {
          btn.style.background = 'rgba(255, 255, 255, 0.1)';
          btn.style.color = 'rgba(255, 255, 255, 0.95)';
        });
        btn.addEventListener('mouseleave', () => {
          btn.style.background = 'transparent';
          btn.style.color = 'rgba(255, 255, 255, 0.7)';
        });
      }

      const zoomOutBtn = document.createElement('button');
      zoomOutBtn.innerHTML = '<svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 12h-15" /></svg>';
      zoomOutBtn.setAttribute('aria-label', 'Zoom out');
      styleBtn(zoomOutBtn);

      const zoomLevel = document.createElement('span');
      Object.assign(zoomLevel.style, {
        fontSize: '0.75rem',
        color: 'rgba(255, 255, 255, 0.5)',
        minWidth: '3rem',
        textAlign: 'center',
        fontVariantNumeric: 'tabular-nums',
      });
      zoomLevel.textContent = '100%';

      const zoomInBtn = document.createElement('button');
      zoomInBtn.innerHTML = '<svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>';
      zoomInBtn.setAttribute('aria-label', 'Zoom in');
      styleBtn(zoomInBtn);

      const resetBtn = document.createElement('button');
      resetBtn.innerHTML = '<svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 9V4.5M9 9H4.5M9 9 3.75 3.75M9 15v4.5M9 15H4.5M9 15l-5.25 5.25M15 9h4.5M15 9V4.5M15 9l5.25-5.25M15 15h4.5M15 15v4.5m0-4.5 5.25 5.25" /></svg>';
      resetBtn.setAttribute('aria-label', 'Fit to screen');
      styleBtn(resetBtn);

      const closeBtn = document.createElement('button');
      closeBtn.innerHTML = '<svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" /></svg>';
      closeBtn.setAttribute('aria-label', 'Close fullscreen');
      styleBtn(closeBtn);
      Object.assign(closeBtn.style, {
        marginLeft: '0.5rem',
        borderLeft: '1px solid rgba(255, 255, 255, 0.1)',
        paddingLeft: '0.75rem',
        width: 'auto',
      });

      controls.append(zoomOutBtn, zoomLevel, zoomInBtn, resetBtn, closeBtn);
      header.append(titleEl, controls);

      // Canvas area
      const canvas = document.createElement('div');
      Object.assign(canvas.style, {
        flex: '1',
        display: 'flex',
        alignItems: 'center',
        justifyContent: 'center',
        overflow: 'hidden',
        cursor: 'grab',
        padding: '2rem',
      });

      const svgContainer = document.createElement('div');
      Object.assign(svgContainer.style, {
        display: 'flex',
        alignItems: 'center',
        justifyContent: 'center',
        transformOrigin: 'center center',
        transition: reducedMotion ? 'none' : 'transform 0.1s ease-out',
      });

      // Clone the SVG and size it to fill the viewport
      const svgClone = svgEl.cloneNode(true) as SVGSVGElement;
      const viewBox = svgEl.viewBox.baseVal;
      svgClone.removeAttribute('style');

      // Calculate size to fit within the available viewport
      const availW = window.innerWidth - 96; // 2rem padding each side + margin
      const availH = window.innerHeight - 140; // header + padding
      const svgAspect = viewBox.width / viewBox.height;
      let fitW: number, fitH: number;
      if (availW / availH > svgAspect) {
        fitH = availH;
        fitW = fitH * svgAspect;
      } else {
        fitW = availW;
        fitH = fitW / svgAspect;
      }

      Object.assign(svgClone.style, {
        width: `${fitW}px`,
        height: `${fitH}px`,
        filter: 'drop-shadow(0 4px 24px rgba(0, 0, 0, 0.3))',
        borderRadius: '14px',
        background: PALETTES[currentTheme].page,
        padding: '1.5rem',
        boxSizing: 'content-box',
      });

      svgContainer.appendChild(svgClone);
      canvas.appendChild(svgContainer);
      overlay.append(header, canvas);
      document.body.appendChild(overlay);
      document.body.style.overflow = 'hidden';

      // Animate in
      requestAnimationFrame(() => {
        overlay.style.opacity = '1';
      });

      // Fullscreen zoom/pan state
      let fsScale = 1;
      let fsPanX = 0;
      let fsPanY = 0;
      let fsDragging = false;
      let fsStartX = 0;
      let fsStartY = 0;

      function applyFsTransform() {
        svgContainer.style.transform = `translate(${fsPanX}px, ${fsPanY}px) scale(${fsScale})`;
        zoomLevel.textContent = `${Math.round(fsScale * 100)}%`;
      }

      function fitToScreen() {
        fsScale = 1;
        fsPanX = 0;
        fsPanY = 0;
        applyFsTransform();
      }

      zoomInBtn.addEventListener('click', () => {
        fsScale = Math.min(fsScale * 1.2, 5);
        applyFsTransform();
      });

      zoomOutBtn.addEventListener('click', () => {
        fsScale = Math.max(fsScale * 0.8, 0.2);
        applyFsTransform();
      });

      resetBtn.addEventListener('click', fitToScreen);

      canvas.addEventListener('wheel', (e) => {
        e.preventDefault();
        fsScale *= e.deltaY > 0 ? 0.9 : 1.1;
        fsScale = Math.max(0.2, Math.min(fsScale, 5));
        applyFsTransform();
      }, { passive: false });

      canvas.addEventListener('mousedown', (e) => {
        fsDragging = true;
        fsStartX = e.clientX - fsPanX;
        fsStartY = e.clientY - fsPanY;
        canvas.style.cursor = 'grabbing';
      });

      const fsMove = (e: MouseEvent) => {
        if (!fsDragging) return;
        fsPanX = e.clientX - fsStartX;
        fsPanY = e.clientY - fsStartY;
        applyFsTransform();
      };

      const fsUp = () => {
        fsDragging = false;
        canvas.style.cursor = 'grab';
      };

      document.addEventListener('mousemove', fsMove);
      document.addEventListener('mouseup', fsUp);

      function closeOverlay() {
        overlay.style.opacity = '0';
        const cleanup = () => {
          document.removeEventListener('mousemove', fsMove);
          document.removeEventListener('mouseup', fsUp);
          overlay.remove();
          document.body.style.overflow = '';
        };
        if (reducedMotion) {
          cleanup();
        } else {
          overlay.addEventListener('transitionend', cleanup, { once: true });
        }
      }

      closeBtn.addEventListener('click', closeOverlay);
      overlay.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeOverlay();
      });

      canvas.addEventListener('dblclick', fitToScreen);

      // Focus overlay for keyboard events
      overlay.setAttribute('tabindex', '-1');
      overlay.focus();
    }

    // Event listener for fullscreen button
    wrapper.querySelector('.fullscreen-btn')?.addEventListener('click', handleFullscreen);

    // Event listeners for minimap zoom controls
    wrapper.querySelector('.minimap-zoom-in')?.addEventListener('click', () => handleZoom('in'));
    wrapper.querySelector('.minimap-zoom-out')?.addEventListener('click', () => handleZoom('out'));
    wrapper.querySelector('.minimap-reset')?.addEventListener('click', () => handleZoom('reset'));

    // Event listeners for export buttons
    wrapper.querySelector('.export-png-btn')?.addEventListener('click', handleExportPNG);
    wrapper.querySelector('.export-svg-btn')?.addEventListener('click', handleExportSVG);

    // Mouse interactions for main preview pan/zoom
    previewDiv.addEventListener('wheel', handleWheel, { passive: false });
    previewDiv.addEventListener('mousedown', handleMouseDown);
    document.addEventListener('mousemove', handleMouseMove);
    document.addEventListener('mouseup', handleMouseUp);
    previewDiv.style.cursor = 'grab';

    // Minimap interactions
    minimapViewport.addEventListener('mousedown', handleMinimapViewportMouseDown);
    document.addEventListener('mousemove', handleMinimapMouseMove);
    document.addEventListener('mouseup', handleMinimapMouseUp);
    minimapCanvas.addEventListener('click', handleMinimapClick);

    // Watch for theme changes and re-render
    const observer = new MutationObserver((mutations) => {
      mutations.forEach((mutation) => {
        if (mutation.attributeName === 'class') {
          const newTheme = detectTheme();
          if (newTheme !== currentTheme) {
            currentTheme = newTheme;
            renderMermaid(code);
          }
        }
      });
    });

    observer.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['class'],
    });

    // Initial render
    renderMermaid(code);
  }

  // Initialize all diagrams on page load
  function initializeAllDiagrams() {
    document.querySelectorAll('.mermaid-wrapper').forEach((wrapper) => {
      initializeDiagram(wrapper as HTMLElement);
    });
  }

  // Run on initial page load (with DOM-ready guard for dev server)
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeAllDiagrams);
  } else {
    initializeAllDiagrams();
  }

  // Re-initialize on Astro page transitions
  document.addEventListener('astro:page-load', initializeAllDiagrams);
</script>

