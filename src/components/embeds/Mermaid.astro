---
interface Props {
  /** The Mermaid diagram code */
  code: string;
  /** Optional title for accessibility */
  title?: string;
}

const { code, title = "Mermaid diagram" } = Astro.props;
const diagramId = `mermaid-${Math.random().toString(36).substring(2, 9)}`;
---

<div class="mermaid-wrapper not-prose my-6" data-diagram-id={diagramId} data-diagram-title={title}>
  <!-- Controls bar -->
  <div class="mermaid-bar">
    <div class="flex items-center gap-3 min-w-0">
      {title && title !== "Mermaid diagram" && (
        <span class="mermaid-title">{title}</span>
      )}
    </div>
    <div class="flex items-center gap-1">
      <span class="mermaid-hint hidden sm:inline" title="Hold Ctrl (or Cmd on Mac) and scroll, or pinch, to zoom">Ctrl+scroll to zoom</span>
      <button
        class="mermaid-btn fullscreen-btn"
        data-action="fullscreen"
        aria-label="View fullscreen"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3.75v4.5m0-4.5h4.5m-4.5 0L9 9M3.75 20.25v-4.5m0 4.5h4.5m-4.5 0L9 15M20.25 3.75h-4.5m4.5 0v4.5m0-4.5L15 9m5.25 11.25h-4.5m4.5 0v-4.5m0 4.5L15 15" />
        </svg>
        <span class="hidden sm:inline">Fullscreen</span>
      </button>
      <button
        class="mermaid-btn export-svg-btn"
        data-action="export-svg"
        aria-label="Export as SVG"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" />
        </svg>
        <span class="hidden sm:inline">SVG</span>
      </button>
      <button
        class="mermaid-btn export-png-btn"
        data-action="export-png"
        aria-label="Export as PNG"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909M3.75 21h16.5A2.25 2.25 0 0 0 22.5 18.75V5.25A2.25 2.25 0 0 0 20.25 3H3.75A2.25 2.25 0 0 0 1.5 5.25v13.5A2.25 2.25 0 0 0 3.75 21Z" />
        </svg>
        <span class="hidden sm:inline">PNG</span>
      </button>
    </div>
  </div>

  <!-- Pele renders the SVG (or its error) into this block -->
  <div class="mermaid-canvas" role="img" aria-label={title}></div>

  <!-- Store diagram code in data attribute -->
  <script is:inline type="application/json" class="diagram-code" set:html={JSON.stringify(code)}></script>
</div>

<script>
  import { mountAsync, type MountOptions } from 'pele/lazy';
  import { exportMermaidPNG } from '../../utils/exportMermaidPNG';

  // Pele lays out the diagram with these, so they have to match the CSS
  // variables below. Colours come from CSS alone and follow the site theme
  // without a re-render.
  const OPTIONS: MountOptions = {
    fontSize: 14,
    padding: 16,
    zoom: { always: true }
  };

  // Pele's attributes reference CSS variables, and the node classes restyle
  // shapes from the page's CSS. Standalone files see neither, so bake in the
  // colours each element resolves to on screen.
  function snapshotSvg(svgEl: SVGSVGElement) {
    const clone = svgEl.cloneNode(true) as SVGSVGElement;
    const originals = [svgEl, ...svgEl.querySelectorAll('*')];
    const copies = [clone, ...clone.querySelectorAll('*')];

    originals.forEach((original, i) => {
      const copy = copies[i];
      const computed = getComputedStyle(original);
      for (const attr of Array.from(copy.attributes)) {
        if (attr.name === 'fill' || attr.name === 'stroke') {
          copy.setAttribute(attr.name, computed.getPropertyValue(attr.name));
        } else if (attr.value.includes('var(')) {
          copy.setAttribute(
            attr.name,
            attr.value.replace(/var\((--[\w-]+)(?:,[^()]*(?:\([^()]*\)[^()]*)*)?\)/g, (match, name) =>
              computed.getPropertyValue(name).trim() || match
            )
          );
        }
      }
    });

    const viewBox = svgEl.viewBox.baseVal;
    clone.style.removeProperty('max-width');
    clone.style.removeProperty('height');
    clone.style.removeProperty('touch-action');
    clone.style.removeProperty('transform');
    clone.style.removeProperty('transform-origin');
    clone.setAttribute('xmlns', 'http://www.w3.org/2000/svg');
    clone.setAttribute('width', String(viewBox.width));
    clone.setAttribute('height', String(viewBox.height));
    return clone;
  }

  // Function to initialize a single diagram wrapper
  function initializeDiagram(wrapper: HTMLElement) {
    // Guard against double-initialization (HMR in dev mode)
    if (wrapper.hasAttribute('data-mermaid-initialized')) return;
    wrapper.setAttribute('data-mermaid-initialized', 'true');

    // Get diagram code from JSON script tag
    const codeScript = wrapper.querySelector('.diagram-code');
    const canvas = wrapper.querySelector('.mermaid-canvas') as HTMLElement | null;
    if (!codeScript || !canvas) {
      console.error('[Mermaid] Diagram elements not found');
      return;
    }

    let code: string;
    try {
      code = JSON.parse(codeScript.textContent || '""').trim();
    } catch (e) {
      console.error('[Mermaid] Failed to parse code JSON:', e);
      return;
    }

    const diagramId = wrapper.getAttribute('data-diagram-id') || 'mermaid-default';
    const diagramTitle = wrapper.getAttribute('data-diagram-title') || '';
    const hasTitle = diagramTitle && diagramTitle !== 'Mermaid diagram';

    function filename(ext: string) {
      return hasTitle
        ? `${diagramTitle.replace(/[^a-z0-9]/gi, '_').toLowerCase()}.${ext}`
        : `${diagramId}.${ext}`;
    }

    function currentSvg() {
      return canvas!.querySelector('svg.pele') as SVGSVGElement | null;
    }

    function handleExportPNG() {
      const svgEl = currentSvg();
      if (svgEl) exportMermaidPNG(snapshotSvg(svgEl), filename('png'));
    }

    function handleExportSVG() {
      const svgEl = currentSvg();
      if (!svgEl) return;

      const svg = new XMLSerializer().serializeToString(snapshotSvg(svgEl));
      const url = URL.createObjectURL(new Blob([svg], { type: 'image/svg+xml' }));
      const a = document.createElement('a');
      a.href = url;
      a.download = filename('svg');
      a.click();
      URL.revokeObjectURL(url);
    }

    // Fullscreen overlay: a second Pele mount sized to the viewport, so it
    // gets the same zoom, pan and keyboard controls as the inline diagram
    async function handleFullscreen() {
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const overlay = document.createElement('div');
      overlay.className = 'mermaid-wrapper mermaid-overlay';
      overlay.setAttribute('role', 'dialog');
      overlay.setAttribute('aria-modal', 'true');
      overlay.setAttribute('aria-label', hasTitle ? diagramTitle : 'Diagram');
      overlay.tabIndex = -1;
      if (reducedMotion) overlay.style.transition = 'none';

      const header = document.createElement('div');
      header.className = 'mermaid-bar';

      const titleEl = document.createElement('span');
      titleEl.className = 'mermaid-title';
      titleEl.textContent = hasTitle ? diagramTitle : 'Diagram';

      const closeBtn = document.createElement('button');
      closeBtn.className = 'mermaid-btn';
      closeBtn.innerHTML = '<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" /></svg><span>Close</span>';
      closeBtn.setAttribute('aria-label', 'Close fullscreen');

      const fsCanvas = document.createElement('div');
      fsCanvas.className = 'mermaid-canvas';
      fsCanvas.setAttribute('role', 'img');
      fsCanvas.setAttribute('aria-label', titleEl.textContent);

      header.append(titleEl, closeBtn);
      overlay.append(header, fsCanvas);
      document.body.appendChild(overlay);
      document.body.style.overflow = 'hidden';

      const mounted = await mountAsync(fsCanvas, code, { ...OPTIONS, autoDirection: false });

      requestAnimationFrame(() => {
        overlay.style.opacity = '1';
        overlay.focus();
      });

      function closeOverlay() {
        overlay.style.opacity = '0';
        const cleanup = () => {
          mounted.destroy();
          overlay.remove();
          document.body.style.overflow = '';
          wrapper.querySelector<HTMLButtonElement>('.fullscreen-btn')?.focus();
        };
        if (reducedMotion) {
          cleanup();
        } else {
          overlay.addEventListener('transitionend', cleanup, { once: true });
        }
      }

      closeBtn.addEventListener('click', closeOverlay);
      overlay.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeOverlay();
      });
    }

    wrapper.querySelector('.fullscreen-btn')?.addEventListener('click', handleFullscreen);
    wrapper.querySelector('.export-png-btn')?.addEventListener('click', handleExportPNG);
    wrapper.querySelector('.export-svg-btn')?.addEventListener('click', handleExportSVG);

    mountAsync(canvas, code, OPTIONS).catch((err) => {
      console.error('[Mermaid] Failed to load diagram type:', err);
    });
  }

  // Initialize all diagrams on page load
  function initializeAllDiagrams() {
    document.querySelectorAll('.mermaid-wrapper').forEach((wrapper) => {
      initializeDiagram(wrapper as HTMLElement);
    });
  }

  // Run on initial page load (with DOM-ready guard for dev server)
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeAllDiagrams);
  } else {
    initializeAllDiagrams();
  }

  // Re-initialize on Astro page transitions
  document.addEventListener('astro:page-load', initializeAllDiagrams);
</script>

<style is:global>
  .mermaid-wrapper {
    max-width: 100%;
    overflow: hidden;
    border: 1px solid var(--rule);
    border-radius: 14px;
    background: var(--paper);

    /* Workbench tokens (DESIGN.md) mapped onto Pele's theme variables */
    --pele-bg: var(--paper);
    --pele-fg: var(--ink);
    --pele-fg-on-light: #0b0b0c;
    --pele-fg-on-dark: #ededef;
    --pele-muted: var(--ink-muted);
    --pele-line: var(--ink-muted);
    --pele-surface: var(--paper-well);
    --pele-surface-alt: var(--paper);
    --pele-border: var(--rule-strong);
    --pele-accent: var(--accent-fill);
    --pele-critical: var(--callout-caution);
    --pele-error: var(--callout-caution);
    --pele-font: var(--font-sans);
    --pele-font-mono: var(--font-mono);
    --pele-radius: 8px;
    --pele-zoom-top: 0.75rem;
    --pele-zoom-right: 0.75rem;
    --pele-zoom-bottom: auto;
    --pele-zoom-left: auto;
  }

  /* Posts mark nodes with `class <ids> accent|ok|error`. Pele keeps the class
     on the node group, so retint that node's shape and it follows the theme. */
  .mermaid-wrapper .pele-node.accent > :not(text, foreignObject) {
    fill: color-mix(in srgb, var(--accent-fill) 18%, var(--paper));
    stroke: var(--accent-fill);
  }

  .mermaid-wrapper .pele-node.ok > :not(text, foreignObject) {
    fill: color-mix(in srgb, var(--callout-tip) 14%, var(--paper));
    stroke: var(--callout-tip);
  }

  .mermaid-wrapper .pele-node.error > :not(text, foreignObject) {
    fill: color-mix(in srgb, var(--callout-caution) 9%, var(--paper));
    stroke: var(--callout-caution);
  }

  .mermaid-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.5rem 0.75rem 0.5rem 1rem;
    background: var(--paper-well);
    border-bottom: 1px solid var(--rule);
  }

  .mermaid-title {
    font-size: 13px;
    font-weight: 600;
    color: var(--ink);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .mermaid-hint {
    margin-right: 0.5rem;
    font-size: 12px;
    color: var(--ink-muted);
  }

  .mermaid-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.25rem 0.625rem;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 500;
    color: var(--ink-muted);
    background: transparent;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .mermaid-btn:hover {
    background: var(--paper-deep);
    color: var(--ink);
  }

  .mermaid-btn:focus-visible {
    outline: 2px solid var(--accent-fill);
    outline-offset: 1px;
  }

  .mermaid-canvas {
    display: block;
    position: relative;
    min-height: 200px;
    padding: 1rem 0;
    font-family: var(--font-sans);
  }

  .mermaid-canvas svg.pele {
    display: block;
    margin-inline: auto;
  }

  /* Fullscreen overlay */
  .mermaid-overlay {
    position: fixed;
    inset: 0;
    z-index: 99998;
    display: flex;
    flex-direction: column;
    border: 0;
    border-radius: 0;
    opacity: 0;
    transition: opacity 0.3s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .mermaid-overlay .mermaid-canvas {
    flex: 1;
    min-height: 0;
    padding: 1.5rem;
    overflow: hidden;
  }

  /* Open tall diagrams fitted to the viewport; Pele's zoom takes it from there */
  .mermaid-overlay svg.pele {
    max-height: 100%;
  }

  /* Hide the JSON script tag */
  .diagram-code {
    display: none;
  }
</style>
