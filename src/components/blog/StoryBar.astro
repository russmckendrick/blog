---
import { getTagUrl, getTagName, getTagColorClasses } from '../../utils/tags';
import UseWithAI from './UseWithAI.astro';
import { Icon } from 'astro-icon/components';
import { PREFERRED_SOURCE } from '../../consts';

/**
 * Hairline storybar: tags left, actions right, sitting directly under the
 * byline. It carries what the article rail shows in the right margin, so it
 * only renders below 1200px — above that the rail is on screen and this would
 * duplicate it. Contents stay rail-only; there is no inline table of contents.
 */
interface Props {
	tags?: string[];
	markdownHref: string;
	pageUrl: string;
	editUrl?: string;
	editTitle?: string;
	rssHref: string;
}

const { tags = [], markdownHref, pageUrl, editUrl, editTitle, rssHref } = Astro.props;
---

<div class="storybar">
	{tags.length > 0 && (
		<p class="storybar-tags">
			{tags.slice(0, 4).map((tag) => (
				<a href={getTagUrl(tag)} class={`${getTagColorClasses(tag)} tag-editorial--sm`}>{getTagName(tag)}</a>
			))}
		</p>
	)}
	<div class="storybar-actions">
		<UseWithAI id="use-with-ai-bar" markdownHref={markdownHref} pageUrl={pageUrl} />
		{editUrl && (
			<a href={editUrl} rel="noopener noreferrer edit" target="_blank" class="action-pill" title={editTitle}>
				<Icon name="simple-icons:github" class="action-pill-icon action-pill-icon--github" aria-hidden="true" />
				<span>Suggest edits</span>
			</a>
		)}
		<a href={rssHref} class="action-pill">
			<Icon name="rss-color" class="action-pill-icon" aria-hidden="true" />
			<span>RSS</span>
		</a>
		<a href={PREFERRED_SOURCE.url} rel="noopener noreferrer" target="_blank" class="action-pill" title={PREFERRED_SOURCE.title}>
			<Icon name="google-color" class="action-pill-icon" aria-hidden="true" />
			<span>{PREFERRED_SOURCE.text}</span>
		</a>
	</div>
</div>

<style>
	.storybar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem 1.25rem;
		margin-top: 1.5rem;
		padding: 0.875rem 0;
		border-top: 1px solid var(--color-outline-variant);
		border-bottom: 1px solid var(--color-outline-variant);
	}

	/* The rail owns this content once there is a margin to put it in. */
	@media (min-width: 1200px) {
		.storybar {
			display: none;
		}
	}

	.storybar-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.375rem;
		min-width: 0;
	}

	.storybar-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 0.75rem;
	}

	/* Narrow screens give the actions a block of their own: the AI trigger
	   across the top, the links splitting the rows beneath 2-up. Above 640px
	   there is room for them to sit inline beside the tags. */
	@media (max-width: 639px) {
		.storybar {
			flex-direction: column;
			align-items: stretch;
		}

		.storybar-actions {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 0.5rem;
			width: 100%;
		}

		.storybar-actions :global(.uwai),
		.storybar-actions :global(.action-pill) {
			width: 100%;
		}

		.storybar-actions :global(.uwai) {
			grid-column: 1 / -1;
		}

		/* Chevron to the far edge once the trigger spans the row. */
		.storybar-actions :global(.uwai-chev) {
			margin-left: auto;
		}

		/* Three links after the trigger leave the last on its own at the
		   bottom (with no editUrl the two fill the row). Let the orphan span
		   rather than sit at half width with a gap beside it. */
		.storybar-actions .action-pill:last-child:nth-child(4) {
			grid-column: 1 / -1;
		}
	}
</style>
