---
import type { CollectionEntry } from 'astro:content'
import FormattedDate from './FormattedDate.astro'
import { getPostUrl } from '../../utils/url.ts'
import { calculateReadingTime, formatReadingTime } from '../../utils/reading-time'
import { getTagName } from '../../utils/tags'
import { getCFImageUrl, generateCFSrcSet, getLQIPUrl } from '../../utils/cloudflare-images'
import { AI_AUTHOR, CF_IMAGE_PRESETS } from '../../consts'

interface Props {
	post: CollectionEntry<'blog'> | CollectionEntry<'tunes'>;
	priority?: boolean; // For LCP optimization on first row
	/** Legacy variants all collapse onto the single Reading Room row. */
	variant?: 'vertical' | 'horizontal' | 'featured' | 'grid' | 'row';
	headingLevel?: '2' | '3'; // Heading level for accessibility
}

const { post, priority = false, headingLevel = '2' } = Astro.props
const HeadingTag = `h${headingLevel}` as 'h2' | 'h3'
const href = getPostUrl(post.data.pubDate, post.data.title)
const cover = 'cover' in post.data ? post.data.cover : undefined
const heroImage = post.data.heroImage || cover?.image
const alt = cover?.alt || post.data.title
const description = ('summary' in post.data ? post.data.summary : undefined) || post.data.description
const minutes = calculateReadingTime(post.body ?? '')
const readingTime = formatReadingTime(minutes)
const isAIAuthored = (post.data.author || AI_AUTHOR.name) === AI_AUTHOR.name && post.collection === 'tunes'
const tags = post.data.tags ?? []

// Shared-element view transition names: the listing image/title morph
// into the article hero/title on navigation.
const transitionKey = href.replace(/[^a-zA-Z0-9]+/g, '-').replace(/^-|-$/g, '')
const imageTransition = `post-img-${transitionKey}`
const titleTransition = `post-title-${transitionKey}`

// Generate LQIP placeholder URL for blur-up effect
// Skip LQIP for priority images to eliminate critical request chain (LCP optimization)
const lqipUrl = heroImage && !priority ? getLQIPUrl(heroImage) : null
const preset = CF_IMAGE_PRESETS.thumbnailHorizontal
---

<a
	href={href}
	aria-label={`Read post: ${post.data.title}`}
	class="group block no-underline focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-4">
	<article class="flex items-start gap-5 sm:gap-10 border-b py-6 sm:py-7" style="border-color: var(--color-outline-variant);">
		<div class="flex-1 min-w-0 flex flex-col gap-2">
			<header>
				<HeadingTag
					class="font-display text-lg sm:text-[1.375rem] text-on-surface leading-[1.3] sm:leading-[1.27] line-clamp-2 transition-colors group-hover:text-[var(--color-secondary)]"
					style="font-weight: 700; letter-spacing: -0.014em;"
					transition:name={titleTransition}
				>
					{post.data.title}
				</HeadingTag>
			</header>
			{description && (
				<p class="hidden sm:line-clamp-2 text-base text-on-surface-variant leading-normal">
					{description}
				</p>
			)}
			<p class="rubric mt-1.5 flex flex-wrap items-center gap-x-1.5">
				<FormattedDate date={post.data.pubDate} />
				{readingTime && (
					<>
						<span aria-hidden="true">&middot;</span>
						<span>{readingTime}</span>
					</>
				)}
				{tags.length > 0 && (
					<span class="post-row-tags">
						<span aria-hidden="true">&middot;&nbsp;</span>
						{tags.slice(0, 4).map(getTagName).join(', ')}
					</span>
				)}
				{isAIAuthored && (
					<>
						<span aria-hidden="true">&middot;</span>
						<span>AI-generated</span>
					</>
				)}
			</p>
		</div>
		{heroImage && (
			<figure
				class="relative overflow-hidden rounded-[3px] flex-none w-[100px] h-[67px] sm:w-40 sm:h-[107px] mt-1 bg-cover bg-center bg-no-repeat"
				style={lqipUrl ? `background-image: url('${lqipUrl}')` : undefined}
				transition:name={imageTransition}
			>
				{/* LQIP blur overlay - shows while main image loads */}
				{lqipUrl && (
					<div
						class="absolute inset-0 bg-cover bg-center bg-no-repeat blur-lg scale-105 -z-10"
						style={`background-image: url('${lqipUrl}')`}
						aria-hidden="true"
					/>
				)}
				<img
					src={getCFImageUrl(heroImage, {
						width: 320,
						quality: preset.quality,
						format: preset.format,
						fit: preset.fit
					})}
					srcset={generateCFSrcSet(heroImage, preset.widths, preset.quality, preset.format)}
					sizes="(min-width: 640px) 160px, 100px"
					alt={alt}
					width="160"
					height="107"
					loading={priority ? 'eager' : 'lazy'}
					decoding={priority ? 'sync' : 'async'}
					fetchpriority={priority ? 'high' : 'low'}
					class="w-full h-full object-cover"
				/>
			</figure>
		)}
	</article>
</a>

<style>
	/* Tag names hide on the narrowest screens so the meta stays one line */
	@media (max-width: 480px) {
		.post-row-tags {
			display: none;
		}
	}
</style>
