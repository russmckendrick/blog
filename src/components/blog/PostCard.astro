---
import type { CollectionEntry } from 'astro:content'
import FormattedDate from './FormattedDate.astro'
import { getPostUrl } from '../../utils/url.ts'
import { calculateReadingTime, formatReadingTime } from '../../utils/reading-time'
import { getCFImageUrl, generateCFSrcSet } from '../../utils/cloudflare-images'
import { AI_AUTHOR, CF_IMAGE_PRESETS } from '../../consts'

interface Props {
	post: CollectionEntry<'blog'> | CollectionEntry<'tunes'>;
	priority?: boolean; // Eager + fetchpriority=high. Set on tiles inside the initial mobile viewport (first two), not just tile one — a lazy above-the-fold image becomes the LCP element on mobile.
	/** Legacy variants all collapse onto the single Workbench tile. */
	variant?: 'vertical' | 'horizontal' | 'featured' | 'grid' | 'row';
	headingLevel?: '2' | '3'; // Heading level for accessibility
	/** Hide the description (dense contexts such as related posts). */
	compact?: boolean;
}

// The Workbench listing tile: 16:10 cover, date · read time, title, and a
// three-line description. Listings lay tiles out through `.feed` (a 1/2/3
// column grid in global.css); the whole tile is one link.
const { post, priority = false, headingLevel = '2', compact = false } = Astro.props
const HeadingTag = `h${headingLevel}` as 'h2' | 'h3'
const href = getPostUrl(post.data.pubDate, post.data.title)
const cover = 'cover' in post.data ? post.data.cover : undefined
const heroImage = post.data.heroImage || cover?.image
const alt = cover?.alt || post.data.title
const description = ('summary' in post.data ? post.data.summary : undefined) || post.data.description
const readingTime = formatReadingTime(calculateReadingTime(post.body ?? ''))
const isAIAuthored = (post.data.author || AI_AUTHOR.name) === AI_AUTHOR.name && post.collection === 'tunes'
const preset = priority ? CF_IMAGE_PRESETS.thumbnailPriority : CF_IMAGE_PRESETS.thumbnail
// Full-frame .feed grids run 1/2/3 columns; compact tiles sit two-up inside
// the 700px article column ("Keep reading").
const sizes = compact
	? '(min-width: 640px) 334px, calc(100vw - 32px)'
	: '(min-width: 1320px) 392px, (min-width: 1024px) calc((100vw - 144px) / 3), (min-width: 640px) calc((100vw - 80px) / 2), calc(100vw - 32px)'

// Shared-element view transition names: the tile image/title morph into the
// article hero/title on navigation (mirrors BlogPost's derivation).
const transitionKey = href.replace(/[^a-zA-Z0-9]+/g, '-').replace(/^-|-$/g, '')
---

<article class="post-tile">
	<a href={href} class="post-tile-link">
		{heroImage && (
			<img
				src={getCFImageUrl(heroImage, { width: 640, quality: preset.quality, format: preset.format, fit: preset.fit })}
				srcset={generateCFSrcSet(heroImage, preset.widths, preset.quality, preset.format)}
				sizes={sizes}
				alt={alt}
				width="640"
				height="400"
				loading={priority ? 'eager' : 'lazy'}
				decoding={priority ? 'sync' : 'async'}
				fetchpriority={priority ? 'high' : 'low'}
				class="post-tile-image"
				transition:name={`post-img-${transitionKey}`}
			/>
		)}
		<p class="rubric post-tile-meta">
			<FormattedDate date={post.data.pubDate} />
			{readingTime && (
				<>
					<span aria-hidden="true">&middot;</span>
					<span>{readingTime}</span>
				</>
			)}
			{isAIAuthored && (
				<>
					<span aria-hidden="true">&middot;</span>
					<span>AI-generated</span>
				</>
			)}
		</p>
		<HeadingTag class="post-tile-title" transition:name={`post-title-${transitionKey}`}>{post.data.title}</HeadingTag>
		{!compact && description && <p class="post-tile-desc">{description}</p>}
	</a>
</article>

<style>
	.post-tile-link {
		display: block;
		color: var(--color-on-surface);
		text-decoration: none;
	}

	.post-tile-link:hover {
		color: var(--color-on-surface);
	}

	.post-tile-image {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 16 / 10;
		object-fit: cover;
		border-radius: 16px;
		background-color: var(--paper-well);
	}

	.post-tile-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0 0.5rem;
		margin: 1.125rem 0 0.625rem;
	}

	.post-tile-title {
		margin: 0;
		font-size: 1.3125rem;
		line-height: 1.2;
		font-weight: 700;
		letter-spacing: -0.02em;
		color: inherit;
		transition: color var(--dur-quick) ease;
	}

	@media (min-width: 640px) {
		.post-tile-title {
			font-size: 1.4375rem;
		}
	}

	.post-tile-desc {
		margin: 0.625rem 0 0;
		font-size: 0.9375rem;
		line-height: 1.55;
		color: var(--color-on-surface-variant);
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.post-tile-link:hover .post-tile-title,
	.post-tile-link:focus-visible .post-tile-title {
		color: var(--accent);
	}
</style>
