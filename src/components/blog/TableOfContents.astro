---
export interface Heading {
  depth: number;
  text: string;
  slug: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;

// Filter to only show h2 and h3 headings
const tocHeadings = headings.filter(h => h.depth <= 3);

// A long post is the case where the map matters most, so it opens by default;
// short posts stay collapsed. A reader's own toggle still wins (per-post, below).
const defaultOpen = tocHeadings.length >= 4;
---

{tocHeadings.length > 0 && (
  <nav class="toc-wrapper mb-10">
    <details class="group toc-details" id="toc-details" open={defaultOpen}>
      <summary class="toc-summary cursor-pointer select-none py-4 flex items-center gap-2 transition-colors">
        <svg class="toc-chevron w-3.5 h-3.5 transition-transform group-open:rotate-90" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
          <path d="m9 6 6 6-6 6"></path>
        </svg>
        <span class="toc-title">Contents</span>
      </summary>
      <ol class="toc-list pb-4">
        {tocHeadings.map((heading) => (
          <li>
            <a
              href={`#${heading.slug}`}
              class:list={[
                'toc-link',
                { 'toc-link--nested': heading.depth === 3 }
              ]}
            >
              {heading.text}
            </a>
          </li>
        ))}
      </ol>
    </details>
  </nav>
)}

<style>
  .toc-details {
    border-top: 1px solid var(--color-outline-variant);
    border-bottom: 1px solid var(--color-outline-variant);
  }

  .toc-summary {
    list-style: none;
  }

  .toc-summary::-webkit-details-marker {
    display: none;
  }

  .toc-title {
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-on-surface);
  }

  .toc-summary:hover .toc-title {
    color: var(--color-secondary);
  }

  .toc-chevron {
    color: var(--color-on-surface-variant);
  }

  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .toc-link {
    display: block;
    font-size: 0.9375rem;
    line-height: 1.5;
    padding: 0.3rem 0;
    color: var(--color-on-surface-variant);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .toc-link:hover {
    color: var(--color-on-surface);
  }

  .toc-link--nested {
    padding-left: 1.125rem;
    font-size: 0.875rem;
  }
</style>

<script>
  let cleanupToc: (() => void) | undefined

  function initTocState() {
    cleanupToc?.()

    requestAnimationFrame(() => {
      const details = document.getElementById('toc-details') as HTMLDetailsElement | null
      if (!details) return

      const controller = new AbortController()
      const { signal } = controller

      // Key the remembered state per post. A single global key meant closing the
      // TOC once hid the structure on every article, with no visible cause.
      const storageKey = `toc-open:${window.location.pathname}`

      let savedState: string | null = null
      try {
        savedState = localStorage.getItem(storageKey)
      } catch {
        // Storage unavailable (private mode, blocked cookies) — keep the server default
      }
      if (savedState === 'true') {
        details.setAttribute('open', '')
      } else if (savedState === 'false') {
        details.removeAttribute('open')
      }

      details.addEventListener('toggle', () => {
        try {
          localStorage.setItem(storageKey, details.open.toString())
        } catch {
          // Nothing to persist to; the toggle still works for this page view
        }
      }, { signal })

      cleanupToc = () => {
        controller.abort()
      }
    })
  }

  initTocState()
  document.addEventListener('astro:page-load', initTocState)
  document.addEventListener('astro:before-swap', () => {
    cleanupToc?.()
    cleanupToc = undefined
  })
</script>
