---
import UseWithAI from './UseWithAI.astro';
import { Icon } from 'astro-icon/components';
import { PREFERRED_SOURCE } from '../../consts';

export interface Heading {
	depth: number;
	text: string;
	slug: string;
}

interface Props {
	headings?: Heading[];
	maxDepth?: number;
	markdownHref: string;
	pageUrl: string;
	editUrl?: string;
	editTitle?: string;
	rssHref: string;
	/** Which column this instance renders: the left contents list or the right tools. */
	part: 'contents' | 'tools';
}

const { headings = [], maxDepth = 3, markdownHref, pageUrl, editUrl, editTitle, rssHref, part } = Astro.props;

const tocHeadings = part === 'contents' ? headings.filter(h => h.depth <= maxDepth) : [];
const showTools = part === 'tools';
---

<aside class:list={['article-rail', `article-rail--${part}`]} aria-label={part === 'contents' ? 'On this page' : 'Article tools'}>
	<div class="article-rail-inner">
		{tocHeadings.length > 0 && (
			<nav id="toc-rail" aria-label="Contents">
				<p class="article-rail-head">On this page</p>
				<ol class="article-rail-list">
					{tocHeadings.map((heading) => (
						<li>
							<a
								href={`#${heading.slug}`}
								class:list={['toc-rail-link article-rail-link', { 'article-rail-link--nested': heading.depth === 3 }]}
							>
								{heading.text}
							</a>
						</li>
					))}
				</ol>
			</nav>
		)}

		{showTools && <nav aria-label="Actions">
			<p class="article-rail-head">Use this post</p>
			<div class="article-rail-actions">
				<UseWithAI id="use-with-ai-rail" markdownHref={markdownHref} pageUrl={pageUrl} />
				{editUrl && (
					<a href={editUrl} rel="noopener noreferrer edit" target="_blank" class="action-pill" title={editTitle}>
						<Icon name="simple-icons:github" class="action-pill-icon action-pill-icon--github" aria-hidden="true" />
						<span>Suggest edits</span>
					</a>
				)}
				<a href={rssHref} class="action-pill">
					<Icon name="rss-color" class="action-pill-icon" aria-hidden="true" />
					<span>RSS</span>
				</a>
				<a href={PREFERRED_SOURCE.url} rel="noopener noreferrer" target="_blank" class="action-pill" title={PREFERRED_SOURCE.title}>
					<Icon name="google-color" class="action-pill-icon" aria-hidden="true" />
					<span>{PREFERRED_SOURCE.text}</span>
				</a>
			</div>
		</nav>}
	</div>
</aside>

<style>
	/* Two instances flank the 700px text column as grid columns in
	   BlogPost.astro: contents on the left, tools on the right, both sticky.
	   Below 1200px there are no margins to sit in, so both disappear — the
	   StoryBar under the byline carries the tools, headings and the
	   reading-progress rule carry wayfinding. */
	.article-rail {
		display: none;
	}

	@media (min-width: 1200px) {
		.article-rail {
			display: block;
			align-self: stretch;
		}

		.article-rail-inner {
			position: sticky;
			top: 6rem;
			max-height: calc(100vh - 8rem);
			overflow-y: auto;
		}
	}

	.article-rail-head {
		font-size: 0.8125rem;
		font-weight: 600;
		letter-spacing: -0.01em;
		color: var(--color-on-surface);
	}

	.article-rail-list {
		list-style: none;
		padding: 0;
		margin: 0.625rem 0 0;
	}

	.article-rail-link {
		display: flex;
		gap: 0.5rem;
		font-size: 0.875rem;
		line-height: 1.4;
		padding: 0.3rem 0 0.3rem 0.875rem;
		color: var(--color-on-surface-variant);
		text-decoration: none;
		transition: color 0.15s ease;
	}

	.article-rail-link:hover {
		color: var(--color-on-surface);
	}

	.article-rail-link--nested {
		padding-left: 1.75rem;
	}

	/* Current section: ink 600 with an amber dot hung in the left gutter */
	.article-rail-link.active {
		position: relative;
		color: var(--color-on-surface);
		font-weight: 600;
	}

	.article-rail-link.active::before {
		content: '';
		position: absolute;
		left: 0;
		top: calc(0.3rem + 0.45em);
		width: 6px;
		height: 6px;
		border-radius: 9999px;
		background-color: var(--accent-fill);
	}

	.article-rail-link--nested.active::before {
		left: 0.875rem;
	}

	/* Pills, not a link list. They fill the rail so the four actions read as
	   one stack of equal-width controls rather than a ragged edge. */
	.article-rail-actions {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		margin-top: 0.625rem;
	}

	/* Use with AI is a child component, so its root and trigger need :global
	   to be stretched from here. */
	.article-rail-actions :global(.uwai),
	.article-rail-actions :global(.action-pill) {
		width: 100%;
	}

	/* Once the trigger fills the rail the chevron belongs at the far edge,
	   not tucked against the label. */
	.article-rail-actions :global(.uwai-chev) {
		margin-left: auto;
	}

	/* The trigger is a pill in a stack of plain links, so it needs its own
	   gap where the links rely on their padding. */
	.article-rail-actions > :global(.uwai) {
		margin-bottom: 0.375rem;
	}
</style>

<script>
	// Highlight the heading currently in view. Bottom margin keeps the
	// active state on the section being read rather than the next one.
	function initTocRail() {
		const rail = document.getElementById('toc-rail')
		if (!rail) return

		const links = Array.from(rail.querySelectorAll<HTMLAnchorElement>('.toc-rail-link'))
		if (links.length === 0) return

		const bySlug = new Map<string, HTMLAnchorElement>()
		for (const link of links) {
			const slug = decodeURIComponent(link.hash.slice(1))
			bySlug.set(slug, link)
		}

		const targets = Array.from(bySlug.keys())
			.map(slug => document.getElementById(slug))
			.filter((el): el is HTMLElement => el !== null)
		if (targets.length === 0) return

		const setActive = (slug: string | null) => {
			for (const link of links) {
				link.classList.toggle('active', slug !== null && decodeURIComponent(link.hash.slice(1)) === slug)
			}
		}

		const visible = new Set<string>()
		const observer = new IntersectionObserver((entries) => {
			for (const entry of entries) {
				const id = entry.target.id
				if (entry.isIntersecting) visible.add(id)
				else visible.delete(id)
			}
			// Prefer the first visible heading in document order; otherwise the
			// last heading above the viewport keeps its section active.
			const firstVisible = targets.find(t => visible.has(t.id))
			if (firstVisible) {
				setActive(firstVisible.id)
				return
			}
			let lastAbove: HTMLElement | null = null
			for (const target of targets) {
				if (target.getBoundingClientRect().top < 120) lastAbove = target
			}
			setActive(lastAbove?.id ?? null)
		}, { rootMargin: '0px 0px -60% 0px', threshold: 0 })

		targets.forEach(target => observer.observe(target))
	}

	initTocRail()
</script>
