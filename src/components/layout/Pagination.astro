---
interface Props {
	currentPage: number;
	totalPages: number;
	getHref: (page: number) => string;
	hideIfSingle?: boolean;
	/** Label for the forward (older content) link, e.g. "Older posts". */
	olderLabel?: string;
	/** Label for the backward (newer content) link, e.g. "Newer posts". */
	newerLabel?: string;
}

const {
	currentPage,
	totalPages,
	getHref,
	hideIfSingle = true,
	olderLabel = 'Older posts',
	newerLabel = 'Newer posts',
} = Astro.props;

if (hideIfSingle && totalPages <= 1) {
	return;
}

const clamp = (value: number, min: number, max: number) => Math.min(Math.max(value, min), max);

const buildPageList = (current: number, total: number) => {
	const pages: Array<number | 'ellipsis'> = [];
	const showRange = 1; // number of pages to show on each side of current

	const safeTotal = Math.max(total, 1);

	// Up to 7 pages an ellipsis could never hide more than one page — show them all.
	if (safeTotal <= 7) {
		return Array.from({ length: safeTotal }, (_, index) => index + 1);
	}

	const addPage = (page: number) => {
		if (!pages.includes(page)) {
			pages.push(page);
		}
	};

	addPage(1);

	const start = clamp(current - showRange, 2, safeTotal - 1);
	const end = clamp(current + showRange, 2, safeTotal - 1);

	// An ellipsis standing in for a single page is no shorter than the page itself.
	if (start === 3) {
		addPage(2);
	} else if (start > 3) {
		pages.push('ellipsis');
	}

	for (let page = start; page <= end; page += 1) {
		addPage(page);
	}

	if (end === safeTotal - 2) {
		addPage(safeTotal - 1);
	} else if (end < safeTotal - 2) {
		pages.push('ellipsis');
	}

	addPage(safeTotal);

	return pages;
};

const pageItems = buildPageList(currentPage, totalPages);
const previousHref = currentPage > 1 ? getHref(currentPage - 1) : null;
const nextHref = currentPage < totalPages ? getHref(currentPage + 1) : null;
---

<nav class="pagination-row pt-7 grid grid-cols-[1fr_auto_1fr] items-center text-sm text-on-surface-variant" aria-label="Pagination">
	{previousHref ? (
		<a
			href={previousHref}
			rel="prev"
			class="justify-self-start -ml-2.5 no-underline inline-flex items-center gap-1 px-2.5 py-1 hover:text-on-surface"
			aria-label={newerLabel}
		>
			<span aria-hidden="true">&larr;</span>
			<span class="hidden sm:inline">{newerLabel}</span>
		</a>
	) : (
		/* No newer page — hold the grid track so the numbers stay centred. A ghosted
		   label would fail contrast: --ink-muted is only 5.15:1 on paper, so there is
		   no headroom to dim it and still clear AA. */
		<span></span>
	)}
	<span class="flex flex-wrap items-center justify-center gap-x-0.5 gap-y-2">
		{pageItems.map((item) => (
			item === 'ellipsis' ? (
				<span class="px-1 py-1" aria-hidden="true">&hellip;</span>
			) : (
				<a
					href={getHref(item)}
					class:list={[
						'no-underline px-2.5 py-1 hover:text-on-surface',
						item === currentPage && 'pagination-current',
					]}
					aria-current={item === currentPage ? 'page' : undefined}
					aria-label={`Page ${item}`}
				>
					{item}
				</a>
			)
		))}
	</span>
	{nextHref ? (
		<a
			href={nextHref}
			rel="next"
			class="justify-self-end no-underline inline-flex items-center gap-1 py-1 pl-2.5 hover:text-on-surface"
			aria-label={olderLabel}
		>
			<span class="hidden sm:inline">{olderLabel}</span>
			<span aria-hidden="true">&rarr;</span>
		</a>
	) : (
		<span></span>
	)}
</nav>

<style>
	/* 3px padding + 1px border equals the siblings' 4px py-1, so the row height never shifts. */
	.pagination-current {
		color: var(--color-on-surface);
		font-weight: 600;
		border-bottom: 1px solid var(--color-on-surface);
		padding-bottom: 3px;
	}
</style>
