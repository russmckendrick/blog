---
interface Props {
	currentPage: number;
	totalPages: number;
	getHref: (page: number) => string;
	hideIfSingle?: boolean;
	/** Label for the forward (older content) link, e.g. "Older posts". */
	olderLabel?: string;
	/** Label for the backward (newer content) link, e.g. "Newer posts". */
	newerLabel?: string;
}

const {
	currentPage,
	totalPages,
	getHref,
	hideIfSingle = true,
	olderLabel = 'Older posts',
	newerLabel = 'Newer posts',
} = Astro.props;

if (hideIfSingle && totalPages <= 1) {
	return;
}

const clamp = (value: number, min: number, max: number) => Math.min(Math.max(value, min), max);

const buildPageList = (current: number, total: number) => {
	const pages: Array<number | 'ellipsis'> = [];
	const showRange = 1; // number of pages to show on each side of current

	const safeTotal = Math.max(total, 1);

	// Up to 7 pages an ellipsis could never hide more than one page — show them all.
	if (safeTotal <= 7) {
		return Array.from({ length: safeTotal }, (_, index) => index + 1);
	}

	const addPage = (page: number) => {
		if (!pages.includes(page)) {
			pages.push(page);
		}
	};

	addPage(1);

	const start = clamp(current - showRange, 2, safeTotal - 1);
	const end = clamp(current + showRange, 2, safeTotal - 1);

	// An ellipsis standing in for a single page is no shorter than the page itself.
	if (start === 3) {
		addPage(2);
	} else if (start > 3) {
		pages.push('ellipsis');
	}

	for (let page = start; page <= end; page += 1) {
		addPage(page);
	}

	if (end === safeTotal - 2) {
		addPage(safeTotal - 1);
	} else if (end < safeTotal - 2) {
		pages.push('ellipsis');
	}

	addPage(safeTotal);

	return pages;
};

const pageItems = buildPageList(currentPage, totalPages);
const previousHref = currentPage > 1 ? getHref(currentPage - 1) : null;
const nextHref = currentPage < totalPages ? getHref(currentPage + 1) : null;
---

{/* Newer · numbered pages · Older, as one centred row of pill buttons.
    The current page is an ink-filled pill; the step that has nowhere to go
    renders as a disabled pill so the row never jumps. Below 640px the
    Newer/Older labels collapse to arrows. */}
<nav class="pagination" aria-label="Pagination">
	{previousHref ? (
		<a href={previousHref} rel="prev" class="pagination-step" aria-label={newerLabel}>
			<span aria-hidden="true">&larr;</span>
			<span class="pagination-step-label">{newerLabel}</span>
		</a>
	) : (
		<span class="pagination-step is-disabled" aria-hidden="true">
			<span>&larr;</span>
			<span class="pagination-step-label">{newerLabel}</span>
		</span>
	)}
	<ol class="pagination-pages">
		{pageItems.map((item) => (
			<li>
				{item === 'ellipsis' ? (
					<span class="pagination-gap" aria-hidden="true">&hellip;</span>
				) : (
					<a
						href={getHref(item)}
						class:list={['pagination-page', item === currentPage && 'is-current']}
						aria-current={item === currentPage ? 'page' : undefined}
						aria-label={`Page ${item}`}
					>
						{item}
					</a>
				)}
			</li>
		))}
	</ol>
	{nextHref ? (
		<a href={nextHref} rel="next" class="pagination-step" aria-label={olderLabel}>
			<span class="pagination-step-label">{olderLabel}</span>
			<span aria-hidden="true">&rarr;</span>
		</a>
	) : (
		<span class="pagination-step is-disabled" aria-hidden="true">
			<span class="pagination-step-label">{olderLabel}</span>
			<span>&rarr;</span>
		</span>
	)}
</nav>

<style>
	.pagination {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 0.75rem;
		margin-top: 3.5rem;
		font-size: 0.9375rem;
	}

	.pagination-pages {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 0.375rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.pagination-page,
	.pagination-step,
	.pagination-gap {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		min-width: 44px;
		height: 44px;
		border-radius: 9999px;
		font-weight: 600;
		text-decoration: none;
		color: var(--color-on-surface);
	}

	.pagination-page {
		padding: 0 0.75rem;
		border: 1px solid var(--rule);
		transition: border-color var(--dur-quick) ease, background-color var(--dur-quick) ease;
	}

	.pagination-page:hover {
		border-color: var(--rule-strong);
		background-color: var(--paper-well);
		color: var(--color-on-surface);
	}

	.pagination-page.is-current {
		background-color: var(--color-on-surface);
		border-color: var(--color-on-surface);
		color: var(--color-surface);
	}

	.pagination-gap {
		min-width: 1.5rem;
		color: var(--color-on-surface-variant);
	}

	.pagination-step {
		padding: 0 1.125rem;
		border: 1px solid var(--rule-strong);
		transition: background-color var(--dur-quick) ease;
	}

	.pagination-step:hover {
		background-color: var(--paper-well);
		color: var(--color-on-surface);
	}

	/* Mist text on the page stays above 4.5:1, so the dead step is still legible */
	.pagination-step.is-disabled {
		border-color: var(--rule);
		color: var(--color-on-surface-variant);
		font-weight: 500;
	}

	@media (max-width: 639px) {
		.pagination {
			gap: 0.5rem;
		}

		.pagination-step {
			padding: 0;
		}

		.pagination-step-label {
			display: none;
		}
	}
</style>
