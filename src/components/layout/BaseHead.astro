---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../../styles/global.css';
import { Font } from 'astro:assets';
import { AstroSEO } from 'astro-seo-plugin';
import { SITE_NAME, SITE_KEYWORDS } from '../../consts';
import { OG_HEIGHT, OG_SCALE, OG_WIDTH } from '../OpenGraph/dimensions';

interface Props {
	title: string;
	description: string;
	image?: string;
	keywords?: string[];
	datePublished?: Date;
	dateModified?: Date;
	lastModified?: Date;
	author?: string;
	analytics?: Record<string, string>;
	/** Emit `noindex` so the page is crawlable but kept out of results (search, utility pages). */
	noindex?: boolean;
	/** og:type — 'article' on posts, 'website' everywhere else. */
	type?: 'website' | 'article';
	/** article:section (posts only) — the primary tag's display name. */
	articleSection?: string;
	/** article:tag, one tag per entry (posts only). */
	articleTags?: string[];
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Default share image: the homepage's generated Workbench card, so pages
// without a card of their own still share at the declared 2400x1260.
const defaultImage = '/home-og.png';
const { title, description, image = defaultImage, keywords = SITE_KEYWORDS, datePublished, dateModified, lastModified, author, analytics = { content_type: 'page' }, noindex = false, type = 'website', articleSection, articleTags = [] } = Astro.props;

// Only generated cards (*-og.png) are known to be OG_WIDTH x OG_HEIGHT at
// OG_SCALE; any other image is shared without declared dimensions rather
// than with wrong ones.
const isGeneratedCard = /-og\.png$/.test(image || defaultImage);

// The tunes feed is advertised alongside the main one on tunes pages
const isTunes = analytics.content_type === 'tunes' || Astro.url.pathname.startsWith('/tunes/');

// Use lastModified if available, otherwise fall back to dateModified
const effectiveModifiedDate = lastModified || dateModified;

// Construct full image URL
// If image starts with http, use it as is, otherwise construct full URL
const imageURL = image?.startsWith('http')
	? image
	: new URL(image || defaultImage, Astro.site || Astro.url).toString();
---

<!-- Critical meta tags first -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />

<!-- AstroSEO Component for comprehensive SEO management -->
<AstroSEO
	title={title}
	description={description}
	canonical={noindex ? undefined : canonicalURL.toString()}
	openGraph={{
		title: title,
		description: description,
		type: type,
		url: canonicalURL.toString(),
		image: imageURL,
		siteName: SITE_NAME,
		locale: "en_GB"
	}}
	twitter={{
		card: "summary_large_image",
		site: "@russmckendrick",
		creator: "@russmckendrick",
		title: title,
		description: description,
		image: imageURL
	}}
	robots={{
		index: !noindex,
		follow: true
	}}
	additionalMetaTags={[
		{ name: "keywords", content: keywords.join(', ') },
		{ name: "generator", content: Astro.generator },
		...(isGeneratedCard ? [
			{ property: "og:image:width", content: String(OG_WIDTH * OG_SCALE) },
			{ property: "og:image:height", content: String(OG_HEIGHT * OG_SCALE) },
		] : []),
		{ property: "og:image:alt", content: title },
		...(datePublished ? [{ property: "article:published_time", content: datePublished.toISOString() }] : []),
		...(effectiveModifiedDate || datePublished ? [{ property: "article:modified_time", content: (effectiveModifiedDate || datePublished)!.toISOString() }] : []),
		...(author ? [{ property: "article:author", content: author }] : []),
		...(type === 'article' && articleSection ? [{ property: "article:section", content: articleSection }] : []),
		...(type === 'article' ? articleTags.map((tag) => ({ property: "article:tag", content: tag })) : [])
	]}
	additionalLinkTags={[
		{ rel: "icon", type: "image/svg+xml", href: "/favicon.svg" },
		{ rel: "icon", type: "image/x-icon", href: "/favicon.ico" },
		{ rel: "icon", type: "image/png", sizes: "16x16", href: "/favicon-16x16.png" },
		{ rel: "icon", type: "image/png", sizes: "32x32", href: "/favicon-32x32.png" },
		{ rel: "apple-touch-icon", href: "/apple-touch-icon.png" },
		{ rel: "mask-icon", href: "/images/logo.svg" },
		{ rel: "manifest", href: "/site.webmanifest" },
		{ rel: "sitemap", href: "/sitemap-index.xml" },
		{ rel: "alternate", type: "application/rss+xml", title: "Russ.Cloud", href: new URL('rss.xml', Astro.site).toString() },
		...(isTunes ? [{ rel: "alternate", type: "application/rss+xml", title: "Russ.Cloud: Listened to This Week", href: new URL('tunes/rss.xml', Astro.site).toString() }] : []),
		{ rel: "me", href: "https://social.mckendrick.io/@russ" }
	]}
/>

<!-- Browser chrome follows the reader's theme: page white, or the dark page -->
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#0b0b0c" media="(prefers-color-scheme: dark)" />

<!-- Self-hosted fonts via Astro's Fonts API (auto @font-face + CLS-safe fallback metrics). -->
<!--
  No font is preloaded: the LCP element on every page is an image (the hero
  cover), so preloading fonts only steals high-priority bandwidth from the LCP
  image on slow connections. All faces use `font-display: swap` with Astro's
  fallback metrics, so text paints immediately in the fallback (FCP unaffected)
  and swaps in with zero layout shift (CLS stays 0). If a future design makes
  text the LCP element above the fold, re-add `preload` to the relevant family.
-->
<Font cssVariable="--font-geist" />
<Font cssVariable="--font-geist-mono" />


<!-- Note: Giscus and GitHub preconnects moved to BlogPost.astro (only needed on post pages) -->

<!-- Plausible Analytics -->
{/*
  Served first-party: both /js/pa.js and /api/event are proxied by
  worker/index.js. Those routes only exist in the Worker, so the tag is
  production-only — `astro dev` would 404 on it, and captureOnLocalhost is off
  regardless. Use `pnpm run preview:worker` to exercise the real proxy locally.
  See the Plausible section of docs/architecture/seo-implementation.md.
*/}
{Object.entries(analytics).map(([key, value]) => (
	<meta name={`plausible:${key}`} content={value} />
))}
{import.meta.env.PROD && (
	<Fragment>
	<script is:inline async src="/js/pa.js"></script>
	<script is:inline>
		window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
		plausible.init({
			endpoint: '/api/event',
			outboundLinks: true,
			fileDownloads: true,
			customProperties: () => Object.fromEntries(
				[...document.querySelectorAll('meta[name^="plausible:"]')]
					.map((m) => [m.getAttribute('name').slice(9), m.getAttribute('content')])
			)
		})
	</script>
	</Fragment>
)}

<!-- Critical CSS to ensure header is immediately visible -->
<style is:inline>
	.header-wrapper {
		opacity: 1 !important;
		visibility: visible !important;
		display: block !important;
	}
</style>

<!-- Theme initialization to prevent FOUC -->
<script is:inline>
	// Set theme immediately to prevent flash
	function applyThemeImmediately() {
		// Light by default; dark only once the reader has chosen it.
		const isDark = localStorage.theme === 'dark';

		document.documentElement.classList.toggle('dark', isDark);
		document.documentElement.setAttribute('data-theme', isDark ? 'dark' : 'light');
	}

	// Apply on initial load
	applyThemeImmediately();

	// Apply before View Transitions swap to prevent flicker
	document.addEventListener('astro:before-swap', (e) => {
		// Get theme from current page
		const isDark = document.documentElement.classList.contains('dark');

		// Apply to new page before swap
		e.newDocument.documentElement.classList.toggle('dark', isDark);
		e.newDocument.documentElement.setAttribute('data-theme', isDark ? 'dark' : 'light');
	});
</script>
