---
import SearchPanel from '../search/SearchPanel.astro'
---

<dialog id="search-sheet" class="search-sheet" aria-label="Search the archive">
	<SearchPanel variant="sheet" />
</dialog>

<script>
	const dialog = document.getElementById('search-sheet') as HTMLDialogElement | null

	if (dialog && typeof dialog.showModal === 'function') {
		const input = dialog.querySelector<HTMLInputElement>('[data-search-input]')
		const closeButton = dialog.querySelector<HTMLButtonElement>('[data-search-close]')
		const triggers = document.querySelectorAll<HTMLAnchorElement>('[data-search-trigger]')

		const isMac = /mac|iphone|ipad/i.test(navigator.userAgent)
		triggers.forEach((trigger) => {
			trigger.title = `Search the archive (${isMac ? '⌘K' : 'Ctrl+K'})`
		})

		const openSearch = () => {
			// On /search/ the page already has a live input — focus that instead
			const pageInput = document.querySelector<HTMLInputElement>('.search-panel--page [data-search-input]')
			if (pageInput) {
				pageInput.focus()
				pageInput.select()
				return
			}

			if (dialog.open) return
			dialog.showModal()
			input?.focus()
			input?.select()
		}

		triggers.forEach((trigger) => {
			trigger.addEventListener('click', (event) => {
				event.preventDefault()
				openSearch()
			})
		})

		closeButton?.addEventListener('click', () => dialog.close())

		// Clicks on ::backdrop are dispatched with the dialog itself as target
		dialog.addEventListener('click', (event) => {
			if (event.target === dialog) dialog.close()
		})

		document.addEventListener('keydown', (event) => {
			if ((event.metaKey || event.ctrlKey) && !event.altKey && event.key.toLowerCase() === 'k') {
				event.preventDefault()
				dialog.open ? dialog.close() : openSearch()
				return
			}

			// A search input clears itself on Escape, which can swallow the
			// dialog's native cancel — close explicitly instead.
			if (event.key === 'Escape' && dialog.open) {
				event.preventDefault()
				dialog.close()
				return
			}

			if (event.key === '/' && !event.metaKey && !event.ctrlKey && !event.altKey && !dialog.open) {
				const target = event.target
				if (target instanceof Element && target.closest('input, textarea, select, [contenteditable]')) return
				event.preventDefault()
				openSearch()
			}
		})
	}
</script>

<style is:global>
	/* The sheet: a centred panel in the top layer over a veiled page. Below
	   640px it fills the screen. */
	.search-sheet {
		position: fixed;
		inset: 0;
		top: max(8vh, 24px);
		width: min(720px, calc(100% - 32px));
		max-width: none;
		height: fit-content;
		max-height: min(680px, calc(100dvh - max(8vh, 24px) - 24px));
		margin: 0 auto;
		padding: 0;
		overflow: hidden;
		color: var(--ink);
		background: var(--paper);
		border: 1px solid var(--rule);
		border-radius: 22px;
	}

	.search-sheet[open] {
		display: flex;
		flex-direction: column;
	}

	.search-sheet > .search-panel {
		flex: 1;
	}

	.search-sheet::backdrop {
		background: rgb(11 11 12 / 0.32);
	}

	.dark .search-sheet::backdrop {
		background: rgb(0 0 0 / 0.66);
	}

	.dark .search-sheet {
		border-color: var(--rule-strong);
	}

	/* Keep the page from scrolling behind the sheet */
	html:has(.search-sheet[open]) {
		overflow: hidden;
	}

	@media (max-width: 640px) {
		.search-sheet {
			top: 0;
			width: 100%;
			height: 100dvh;
			max-height: 100dvh;
			border: 0;
			border-radius: 0;
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		.search-sheet[open] {
			animation: search-sheet-in 200ms var(--ease-settle);
		}

		.search-sheet[open]::backdrop {
			animation: search-veil-in 200ms ease;
		}
	}

	@keyframes search-sheet-in {
		from {
			opacity: 0;
			transform: translateY(-6px) scale(0.99);
		}
	}

	@keyframes search-veil-in {
		from {
			opacity: 0;
		}
	}
</style>
