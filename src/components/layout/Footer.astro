---
import fs from 'node:fs'
import path from 'node:path'
import { getCollection } from 'astro:content'
import { FOOTER_NAV, SOCIAL_LINKS, SOCIAL_LABELS, AUTHOR_NAME } from '../../consts'
import { getPostUrl } from '../../utils/url'
import { getCFImageUrl } from '../../utils/cloudflare-images'
import Icon from '../ui/Icon.astro'

// "Listened to this week": latest tunes entry + four of its record covers.
// The collection call is served from Astro's content-layer cache; the
// readdir result is memoised on globalThis so ~2k page renders share it.
const tunes = (await getCollection('tunes', ({ data }) => !data.draft))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
const latestTune = tunes[0]
const weeksCount = tunes.length

interface FooterTunesCache {
	id: string
	covers: string[]
}

const cacheStore = globalThis as typeof globalThis & { __footerTunesCovers?: FooterTunesCache }
let covers: string[] = []
if (latestTune) {
	if (cacheStore.__footerTunesCovers?.id === latestTune.id) {
		covers = cacheStore.__footerTunesCovers.covers
	} else {
		const albumsDir = path.join(process.cwd(), 'public', 'assets', latestTune.id, 'albums')
		if (fs.existsSync(albumsDir)) {
			covers = fs.readdirSync(albumsDir)
				.filter(f => /\.(jpe?g|png|webp)$/i.test(f))
				.sort()
				.slice(0, 4)
				.map(f => `/assets/${latestTune.id}/albums/${f}`)
		}
		cacheStore.__footerTunesCovers = { id: latestTune.id, covers }
	}
}

const latestTuneUrl = latestTune ? getPostUrl(latestTune.data.pubDate, latestTune.data.title) : '/tunes/'
const today = new Date()
---

<footer class="mt-16 border-t" style="border-color: var(--color-outline-variant);">
	<div class="max-w-[728px] mx-auto px-6 pt-11 pb-1 grid grid-cols-1 sm:grid-cols-2 gap-9 sm:gap-12">
		<div>
			<p class="text-[15px] font-semibold" style="letter-spacing: -0.01em;">Links</p>
			<div class="footer-social mt-4 flex flex-wrap justify-center sm:justify-start gap-x-3.5 gap-y-2.5 max-w-[240px] mx-auto sm:mx-0">
				{SOCIAL_LINKS.map(link => (
					<a
						href={link.url}
						target="_blank"
						rel="noopener noreferrer"
						aria-label={SOCIAL_LABELS[link.name] ?? link.name}
						title={SOCIAL_LABELS[link.name] ?? link.name}
						class="footer-social-link"
					>
						<Icon name={link.name} size={17} aria-hidden="true" />
					</a>
				))}
			</div>
		</div>

		{latestTune && (
			<div>
				<p class="text-[15px] font-semibold" style="letter-spacing: -0.01em;">Listened to this week</p>
				{covers.length > 0 && (
					<div class="mt-3.5 grid grid-cols-4 gap-2 sm:flex">
						{covers.map(cover => (
							<img
								src={getCFImageUrl(cover, { width: 160, quality: 60 })}
								alt=""
								width="64"
								height="64"
								loading="lazy"
								decoding="async"
								class="w-full aspect-square sm:w-16 sm:h-16 object-cover rounded-[3px]"
							/>
						))}
					</div>
				)}
				<a href={latestTuneUrl} class="footer-tunes-title block mt-3 no-underline text-sm font-semibold leading-snug">
					{latestTune.data.title}
				</a>
				<a href="/tunes/" class="rubric no-underline block mt-1.5 hover:text-on-surface">
					{weeksCount} weeks of listening →
				</a>
			</div>
		)}
	</div>

	<div class="max-w-[728px] mx-auto px-6 pt-6 pb-10">
		<p class="rubric">
			{FOOTER_NAV.map((item, i) => (
				<>
					<a
						href={item.url}
						class="hover:text-on-surface no-underline"
						target={item.external ? '_blank' : undefined}
						rel={item.external ? 'noopener noreferrer' : undefined}
					>{item.name}</a>
					<span aria-hidden="true">{' · '}</span>
				</>
			))}
			&copy; {today.getFullYear()} {AUTHOR_NAME}
		</p>
	</div>
</footer>

<style>
	.footer-social-link {
		color: var(--color-on-surface-variant);
		display: flex;
		transition: color var(--dur-quick) ease;
	}

	.footer-social-link:hover,
	.footer-social-link:focus-visible {
		color: var(--color-on-surface);
	}

	.footer-tunes-title {
		color: var(--color-on-surface);
	}

	.footer-tunes-title:hover {
		color: var(--color-secondary);
	}
</style>
