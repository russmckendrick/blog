---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchPanel from '../components/search/SearchPanel.astro';
---

<BaseLayout title="Search" description="Search Russ.Cloud blog posts and content" noindex>
	<div class="page-frame page-frame--text">
		<section class="pt-4 pb-10 border-b" style="border-color: var(--color-outline-variant);">
			<h1 data-entrance>
				Search
			</h1>
			<p class="page-lede" data-entrance>
				Every post, tunes write-up, book and glossary term.
			</p>
		</section>

		<section class="py-6 md:py-8">
			<SearchPanel variant="page" />
		</section>
	</div>
</BaseLayout>

<script>
	// The page is the no-JS fallback and deep link for the masthead search
	// sheet, so drop the reader straight into the input.
	document.querySelector<HTMLInputElement>('.search-panel--page [data-search-input]')?.focus()
</script>
