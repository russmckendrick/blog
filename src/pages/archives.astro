---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { CF_IMAGE_PRESETS } from '../consts';
import { Schema } from 'astro-seo-schema';
import { createCollectionPageSchema } from '../utils/schema';
import { getCFImageUrl } from '../utils/cloudflare-images';

// Get all posts and tunes
const allPosts = await getCollection('blog');
const allTunes = await getCollection('tunes');

const isPublished = (item: { data: { draft?: boolean } }) => import.meta.env.DEV || !item.data.draft;
const posts = allPosts.filter(isPublished);
const tunes = allTunes.filter(isPublished);

type Cover = Parameters<typeof getCFImageUrl>[0];

// Per year: post and tunes counts plus up to three covers for the card's
// mosaic — blog covers first (newest first), tunes art to fill any gaps.
const byYear = new Map<number, { posts: number; tunes: number; covers: Cover[] }>();
const entry = (year: number) => {
	if (!byYear.has(year)) byYear.set(year, { posts: 0, tunes: 0, covers: [] });
	return byYear.get(year)!;
};
const newestFirst = <T extends { data: { pubDate: Date } }>(items: T[]) =>
	[...items].sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

for (const post of newestFirst(posts)) {
	const year = entry(post.data.pubDate.getFullYear());
	year.posts += 1;
	const image = post.data.heroImage || post.data.cover?.image;
	if (image && year.covers.length < 3) year.covers.push(image);
}
for (const tune of newestFirst(tunes)) {
	const year = entry(tune.data.pubDate.getFullYear());
	year.tunes += 1;
	if (tune.data.heroImage && year.covers.length < 3) year.covers.push(tune.data.heroImage);
}

const years = [...byYear.entries()].sort((a, b) => b[0] - a[0]);
const total = posts.length + tunes.length;
const preset = CF_IMAGE_PRESETS.thumbnail;

const title = 'Archives';
const description = `Every post and weekly tunes write-up on Russ.Cloud since ${years.at(-1)?.[0]}, by year: ${posts.length} posts and ${tunes.length} weeks of listening, from Puppet and Docker to AI coding tools.`;
const siteUrl = Astro.site?.toString() || 'https://www.russ.cloud/';
const collectionSchema = createCollectionPageSchema({
	name: 'Archives',
	description,
	url: new URL('/archives/', siteUrl).toString(),
	items: years.map(([year]) => ({ name: String(year), url: new URL(`/${year}/`, siteUrl).toString() }))
});
---

<BaseLayout title={title} description={description} image="/archives-og.png">
	<Schema slot="head" item={collectionSchema} />
	<section class="page-frame pb-16">
		<header class="page-head" data-entrance>
			<h1>Archives</h1>
			<p class="page-lede">
				{total} entries since {years.at(-1)?.[0]} — {posts.length} posts and {tunes.length} weeks of tunes, by year.
			</p>
		</header>

		<ul class="year-grid" role="list">
			{years.map(([year, stats]) => (
				<li>
					<a href={`/${year}/`} class="year-card">
						<span class="year-mosaic" aria-hidden="true">
							{[0, 1, 2].map((index) => (
								stats.covers[index] ? (
									<img
										src={getCFImageUrl(stats.covers[index], { width: 320, quality: preset.quality, format: preset.format, fit: preset.fit })}
										alt=""
										width="160"
										height="120"
										loading="lazy"
										decoding="async"
									/>
								) : (
									<span class="year-mosaic-blank"></span>
								)
							))}
						</span>
						<span class="year-card-body">
							<span class="year-card-year">{year}</span>
							<span class="rubric">
								{stats.posts > 0 && <>{stats.posts} {stats.posts === 1 ? 'post' : 'posts'}</>}
								{stats.posts > 0 && stats.tunes > 0 && ' · '}
								{stats.tunes > 0 && <>{stats.tunes} {stats.tunes === 1 ? 'week' : 'weeks'} of tunes</>}
							</span>
						</span>
					</a>
				</li>
			))}
		</ul>
	</section>
</BaseLayout>

<style>
	.year-grid {
		display: grid;
		gap: 1.25rem;
		margin: 2.5rem 0 0;
		padding: 0;
		list-style: none;
	}

	@media (min-width: 640px) {
		.year-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (min-width: 1024px) {
		.year-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 1.5rem;
		}
	}

	@media (min-width: 1280px) {
		.year-grid {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}
	}
</style>
