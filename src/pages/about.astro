---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Schema } from 'astro-seo-schema';
import { getCollection } from 'astro:content';
import { createProfilePageSchema } from '../utils/schema';
import { getAvailableAvatars, getAvatarImageUrl } from '../utils/avatars';
import { getCFImageUrl } from '../utils/cloudflare-images';
import { getTagColorClasses, getTagName, normalizeTagSlug } from '../utils/tags';
import HomeProjects from '../components/home/HomeProjects.astro';

const siteUrl = Astro.site?.toString() || 'https://www.russ.cloud/';
// A ProfilePage wrapping the author: Google's preferred markup for a person's
// profile, and the canonical home of the site-wide #person entity.
const profileSchema = createProfilePageSchema(siteUrl, new URL('/about/', siteUrl).toString());

// Avatar renders at 80px in the byline row. Resolve delivery URLs here
// rather than in the client script so the swapped-in avatars go through
// Cloudflare too — the source SVGs are ~90 KiB each.
const AVATAR_RENDER_SIZE = 96;
// Available avatars for client-side random selection, pre-resolved to image URLs
const availableAvatars = getAvailableAvatars()
  .filter(avatar => avatar.endsWith('.svg'))
  .map(avatar => getAvatarImageUrl(`/images/avatars/${avatar}`, AVATAR_RENDER_SIZE));
// Default avatar for initial render (will be replaced client-side).
// Uses anon.svg — the canonical default from consts.ts. The previous
// /images/avatars/avatar.svg does not exist and 404'd; the client-side swap
// masked it, and the portrait carried no onerror fallback.
const defaultAvatarPath = getAvatarImageUrl('/images/avatars/anon.svg', AVATAR_RENDER_SIZE);
const avatarFallback = '/images/avatar-192x192.png';

// The archive is the evidence. Every number below is counted at build time from
// the collections themselves — never hardcoded, so it cannot drift from reality.
const posts = (await getCollection('blog'))
  .filter(post => import.meta.env.DEV || !post.data.draft);
const tunes = (await getCollection('tunes'))
  .filter(entry => import.meta.env.DEV || !entry.data.draft);
const glossary = await getCollection('glossary');
const books = (await getCollection('books'))
  .filter(book => !book.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const firstPost = [...posts].sort(
  (a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf()
)[0];
const writingSince = firstPost
  ? firstPost.data.pubDate.toLocaleDateString('en-GB', { month: 'long', year: 'numeric' })
  : null;

// Top subjects, by how often they actually appear — the same derivation the
// author hub uses, so the two pages can never disagree about what Russ writes.
const tagCounts = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.data.tags ?? []) {
    const slug = normalizeTagSlug(tag);
    tagCounts.set(slug, (tagCounts.get(slug) || 0) + 1);
  }
}
const topTags = Array.from(tagCounts.entries())
  .sort((a, b) => b[1] - a[1])
  .slice(0, 12);

// The four numbers in the intro band, each linking to its hub
const stats = [
  { value: posts.length, label: 'posts', href: '/archives/' },
  { value: tunes.length, label: 'weeks of listening', href: '/tunes/' },
  { value: books.length, label: 'books', href: '/books/' },
  { value: glossary.length, label: 'glossary entries', href: '/glossary/' },
];

const bookCoverWidth = 200;
---

<BaseLayout title="About Russ McKendrick" description="Russ McKendrick: Practice Manager of SRE & DevOps at Node4, author of fourteen technical books, and writing about DevOps, AI tooling and Linux since 2013.">
	<Fragment slot="head">
		<Schema item={profileSchema} />
	</Fragment>
	<!-- Intro band: the same full-width tint as the homepage intro — the
	     clickable avatar, the greeting and lede, and the archive in numbers. -->
	<section class="about-band">
		<div class="page-frame about-band-inner">
			<div>
				<div class="about-heading">
				<button type="button" class="avatar-button block w-fit flex-none" aria-label="Change the avatar" data-entrance>
					<div class="avatar-inner about-avatar">
						<img
							src={defaultAvatarPath}
							alt="Illustrated avatar of Russ McKendrick"
							width="96"
							height="96"
							class="w-full h-full object-cover object-center random-avatar"
							onerror={`this.onerror=null; this.src='${avatarFallback}';`}
						/>
					</div>
				</button>
				<h1 class="about-title" data-entrance>
					<span class="inline-block animate-wave mr-2" style="transform-origin: 70% 70%;">👋</span>Hi there, my name is Russ.
				</h1>
				</div>
				<p class="about-lede" data-entrance>
					I'm an IT professional with a strong background in DevOps and system administration, and I've spent the last 30 years working in IT roles across multiple industries.
				</p>
			</div>

			<ul class="about-stats" role="list" data-entrance>
				{stats.map((stat) => (
					<li>
						<a href={stat.href} class="about-stat">
							<span class="about-stat-value">{stat.value}</span>
							<span class="about-stat-label">{stat.label}</span>
						</a>
					</li>
				))}
			</ul>
		</div>
	</section>

	<!-- Avatar data for client-side random selection -->
	<script is:inline define:vars={{ availableAvatars }}>
		window.__availableAvatars = availableAvatars;
	</script>

	<div class="page-frame pb-6">
		<div class="about-columns">
			<div class="prose" data-reveal>
				<p>
					I have a deep passion for Linux, open-source systems, automation, and containers. I currently serve as the Practice Manager of SRE &amp; DevOps at <a href="https://www.node4.co.uk/" target="_blank" rel="noopener noreferrer">Node4</a>, managing projects across public and private clouds.
				</p>

				<p>
					Apart from my work, I have written and contributed to <a href="/books/">fourteen technical books</a> primarily revolving around container technologies and automation. In my downtime, I enjoy expanding <a href="https://www.russ.fm/" target="_blank" rel="noopener noreferrer">my vinyl record collection</a>.
				</p>

				{writingSince && (
					<p>
						I've been writing here since {writingSince}. These days that mostly means the AI coding tools I use, the small Rust CLIs I build, and keeping a Mac terminal tidy, plus a weekly write-up of <a href="/tunes/">whatever I've been listening to</a>.
					</p>
				)}
			</div>

			<aside class="about-aside" data-reveal>
				{topTags.length > 0 && (
					<div>
						<h2 class="about-aside-head">What I write about</h2>
						<ul class="mt-3 flex flex-wrap gap-2">
							{topTags.map(([slug, count]) => (
								<li>
									<a href={`/tags/${slug}/`} class={getTagColorClasses(slug)}>
										{getTagName(slug)}
										<span class="opacity-70">{count}</span>
									</a>
								</li>
							))}
						</ul>
					</div>
				)}

				<div>
					<h2 class="about-aside-head">Get in touch</h2>
					<p class="mt-2 text-[15px] text-on-surface-variant leading-snug">
						<a href="mailto:web.site@mckendrick.email" class="underline">web.site@mckendrick.email</a>{' '}
						— everywhere else I post is listed at the bottom of this page.
					</p>
				</div>
			</aside>
		</div>

		{books.length > 0 && (
			<section class="pt-16 lg:pt-24" aria-labelledby="about-books" data-reveal>
				<div class="home-section-head">
					<h2 id="about-books" class="home-section-title">The books</h2>
					<a href="/books/" class="home-section-link">All {books.length} with buy links →</a>
				</div>
				<ul class="about-shelf" role="list">
					{books.map((book) => (
						<li>
							<a href={`/books/${book.id}/`} class="book-cover block" title={book.data.title} aria-label={book.data.title}>
								<img
									src={getCFImageUrl(book.data.cover, { width: bookCoverWidth, quality: 70, format: 'auto' })}
									alt={book.data.alt || book.data.title}
									width="100"
									height="124"
									class="w-full"
									loading="lazy"
									decoding="async"
								/>
							</a>
						</li>
					))}
				</ul>
			</section>
		)}

		<div class="pt-16 lg:pt-24 pb-6">
			<HomeProjects />
		</div>
	</div>
</BaseLayout>

<style>
  .about-band {
    background-color: var(--paper-well);
  }

  .about-band-inner {
    display: grid;
    gap: 1.75rem;
    padding-block: 2rem;
  }

  @media (min-width: 1024px) {
    .about-band-inner {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      gap: 4rem;
      align-items: center;
      padding-block: 3rem;
    }
  }

  /* Avatar beside the greeting, centred on it */
  .about-heading {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .about-heading {
      gap: 1.5rem;
    }
  }

  .about-avatar {
    width: 64px;
    height: 64px;
    border-radius: 9999px;
    overflow: hidden;
    background-color: var(--color-surface);
  }

  @media (min-width: 640px) {
    .about-avatar {
      width: 84px;
      height: 84px;
    }
  }

  .about-title {
    margin: 0;
    font-size: clamp(1.875rem, 5vw, 3.5rem);
    line-height: 1.02;
    font-weight: 800;
    letter-spacing: -0.04em;
  }

  .about-lede {
    margin-top: 1rem;
    max-width: 600px;
    font-size: 1.125rem;
    line-height: 1.55;
    color: var(--color-on-surface-variant);
  }

  @media (min-width: 640px) {
    .about-lede {
      font-size: 1.25rem;
    }
  }

  .about-stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .about-stat {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    height: 100%;
    padding: 0.875rem 1.125rem;
    border-radius: 16px;
    background-color: var(--color-surface);
    color: var(--color-on-surface);
    text-decoration: none;
    transition: box-shadow var(--dur-quick) ease;
  }

  .about-stat:hover {
    color: var(--color-on-surface);
    box-shadow: inset 0 0 0 1px var(--rule-strong);
  }

  .about-stat-value {
    font-size: clamp(1.75rem, 3.5vw, 2.25rem);
    line-height: 1;
    font-weight: 800;
    letter-spacing: -0.04em;
  }

  .about-stat:hover .about-stat-value {
    color: var(--accent);
  }

  .about-stat-label {
    font-size: 0.875rem;
    color: var(--color-on-surface-variant);
  }

  .about-columns {
    display: grid;
    gap: 2.5rem;
    padding-top: 3rem;
  }

  @media (min-width: 1024px) {
    .about-columns {
      grid-template-columns: minmax(0, 700px) minmax(0, 360px);
      justify-content: space-between;
      gap: 4rem;
      padding-top: 4.5rem;
    }
  }

  .about-aside {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .about-aside-head {
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.015em;
  }

  .about-shelf {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 640px) {
    .about-shelf {
      grid-template-columns: repeat(7, minmax(0, 1fr));
      gap: 1rem;
    }
  }

  /* Thirteen of the fourteen covers are 81:100; pinning the box to that ratio
     keeps the shelf's rows level, and only the odd cover takes a slight crop. */
  .book-cover img {
    aspect-ratio: 81 / 100;
    object-fit: cover;
    border-radius: 6px;
    background-color: var(--paper-well);
    box-shadow: 0 18px 30px -22px rgba(10, 10, 20, 0.45);
    transition: opacity var(--dur-quick) ease;
  }
  .book-cover:hover img {
    opacity: 0.85;
  }

  .avatar-button {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
  }
</style>

<script>
  // element.animate() ignores CSS media queries, so the reduced-motion contract
  // has to be re-stated in JS or the whole global block is bypassed here.
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  function getRandomAvatar(): string | null {
    // Already resolved to delivery URLs server-side
    const avatars = (window as any).__availableAvatars;
    if (!avatars || avatars.length === 0) return null;
    return avatars[Math.floor(Math.random() * avatars.length)];
  }

  function swapAvatar(scope: ParentNode = document) {
    const avatarPath = getRandomAvatar();
    if (!avatarPath) return;
    scope.querySelectorAll('.random-avatar').forEach((img) => {
      (img as HTMLImageElement).src = avatarPath;
    });
  }

  function spawnPoof(btn: HTMLElement) {
    const rect = btn.getBoundingClientRect();
    const cx = rect.left + rect.width / 2;
    const cy = rect.top + rect.height / 2;
    const radius = rect.width / 2;
    // Never the accent — its scarcity is the identity, and confetti is the one
    // place it would be spent for nothing.
    const colors = ['var(--color-on-surface-variant)', 'var(--color-outline-variant)'];

    for (let i = 0; i < 16; i++) {
      const dot = document.createElement('div');
      const size = 8 + Math.random() * 12;
      const angle = (Math.PI * 2 * i) / 16 + (Math.random() - 0.5) * 0.4;
      const dist = radius * (0.8 + Math.random() * 0.6);
      const tx = Math.cos(angle) * dist;
      const ty = Math.sin(angle) * dist;

      Object.assign(dot.style, {
        position: 'fixed',
        left: `${cx - size / 2}px`,
        top: `${cy - size / 2}px`,
        width: `${size}px`,
        height: `${size}px`,
        borderRadius: '50%',
        backgroundColor: colors[Math.floor(Math.random() * colors.length)],
        pointerEvents: 'none',
        zIndex: '9999',
      });

      document.body.appendChild(dot);

      dot.animate([
        { opacity: 1, transform: 'translate(0, 0) scale(1)' },
        { opacity: 0, transform: `translate(${tx}px, ${ty}px) scale(0)` },
      ], {
        duration: 500,
        easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
        fill: 'forwards',
      }).onfinish = () => dot.remove();
    }
  }

  let poofing = false;

  function setupAvatarClick() {
    document.querySelectorAll('.avatar-button').forEach((btn) => {
      btn.addEventListener('click', () => {
        // Reduced motion still gets the avatar, just without the theatre.
        if (reducedMotion.matches) {
          swapAvatar(btn);
          return;
        }

        if (poofing) return;
        poofing = true;

        const inner = btn.querySelector('.avatar-inner') as HTMLElement;
        if (!inner) { poofing = false; return; }

        spawnPoof(btn as HTMLElement);

        const shrink = inner.animate([
          { transform: 'scale(1)', opacity: 1 },
          { transform: 'scale(0.2)', opacity: 0 },
        ], { duration: 150, easing: 'ease-in', fill: 'forwards' });

        shrink.onfinish = () => {
          swapAvatar(btn);

          // Settles rather than springs — the house easing, no overshoot.
          const grow = inner.animate([
            { transform: 'scale(0.2)', opacity: 0 },
            { transform: 'scale(1)', opacity: 1 },
          ], { duration: 300, easing: 'cubic-bezier(0.22, 0.61, 0.36, 1)', fill: 'forwards' });

          grow.onfinish = () => { poofing = false; };
        };
      });
    });
  }

  // Run on initial page load
  swapAvatar();
  setupAvatarClick();

  // Re-run on View Transitions navigation
  document.addEventListener('astro:page-load', () => {
    swapAvatar();
    setupAvatarClick();
  });
</script>
