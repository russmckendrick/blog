---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/blog/PostCard.astro';
import FormattedDate from '../../components/blog/FormattedDate.astro';
import Pagination from '../../components/layout/Pagination.astro';
import { tunesIndex } from '../../utils/tunes-index';
import { getPostUrl } from '../../utils/url';
import { getCFImageUrl, generateCFSrcSet, getLQIPUrl } from '../../utils/cloudflare-images';
import { calculateReadingTime, formatReadingTime } from '../../utils/reading-time';
import { getTuneCovers } from '../../utils/tune-covers';
import { CF_IMAGE_PRESETS, SOCIAL_LINKS } from '../../consts';
import { Schema } from 'astro-seo-schema';
import { createCollectionPageSchema } from '../../utils/schema';

// Tunes homepage: one lead week + 6 previous weeks as rows
const firstPagePosts = 7;
const subsequentPagePosts = 9;

const allTunes = (await getCollection('tunes'))
	.filter(tune => !tune.data.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const tunes = allTunes.slice(0, firstPagePosts);
const remainingPosts = allTunes.length - firstPagePosts;
const totalPages = 1 + Math.ceil(Math.max(0, remainingPosts) / subsequentPagePosts);

const leadTune = tunes[0];
const previousWeeks = tunes.slice(1);

const leadUrl = leadTune ? getPostUrl(leadTune.data.pubDate, leadTune.data.title) : '/tunes/';
const leadImage = leadTune?.data.heroImage;
const leadMinutes = leadTune ? formatReadingTime(calculateReadingTime(leadTune.body ?? '')) : null;
const leadLqip = leadImage ? getLQIPUrl(leadImage) : null;

// This week's records: up to eight covers from the entry's albums directory
const leadCovers = leadTune ? getTuneCovers(leadTune, 8) : [];

const lastfmUrl = SOCIAL_LINKS.find(l => l.name === 'lastfm')?.url;
const discogsUrl = SOCIAL_LINKS.find(l => l.name === 'discogs')?.url;

const siteUrl = Astro.site?.toString() || 'https://www.russ.cloud/';
const tunesDescription = "What I've been playing, week by week: every Listened to This Week post on Russ.Cloud, with AI-written notes on the records from my own collection.";
const tunesSchema = createCollectionPageSchema({
	name: 'Listened to This Week',
	description: tunesDescription,
	url: new URL('/tunes/', siteUrl).toString(),
	items: tunes.map((tune) => ({ name: tune.data.title, url: new URL(getPostUrl(tune.data.pubDate, tune.data.title), siteUrl).toString() })),
	numberOfItems: allTunes.length
});
---

<BaseLayout title="Listened to This Week" description={tunesDescription}>
	<Schema slot="head" item={tunesSchema} />
	<section class="page-frame">
		<header class="page-head !border-b-0 !pb-2" data-entrance>
			<h1>Listened to This Week</h1>
			<p class="page-lede">What's been on the turntable, week by week — {allTunes.length} weeks so far, written up by AI from my own records.</p>
		</header>

		<nav aria-label="Browse the tunes archive" class="tunes-tabs">
			<a href="/tunes/" aria-current="page">Latest weeks</a>
			<a href="/tunes/artist/">Artists<span class="tab-count">{tunesIndex.totals.artists}</span></a>
			<a href="/tunes/album/">Albums<span class="tab-count">{tunesIndex.totals.albums}</span></a>
			<a href="/tunes/year/">By year</a>
		</nav>

		{leadTune && (
			<article class="pt-8 pb-8 border-b" style="border-color: var(--color-outline-variant);" data-entrance>
				{leadImage && (
					<a href={leadUrl} class="block no-underline" aria-label={`Read: ${leadTune.data.title}`}>
						<figure
							class="relative overflow-hidden rounded-[16px] lg:rounded-[22px] bg-cover bg-center bg-no-repeat"
							style={leadLqip ? `background-image: url('${leadLqip}')` : undefined}
						>
							{leadLqip && (
								<div
									class="absolute inset-0 bg-cover bg-center bg-no-repeat blur-lg scale-105 -z-10"
									style={`background-image: url('${leadLqip}')`}
									aria-hidden="true"
								/>
							)}
							<img
								src={getCFImageUrl(leadImage, {
									width: 1536,
									quality: CF_IMAGE_PRESETS.hero.quality,
									format: CF_IMAGE_PRESETS.hero.format,
									fit: CF_IMAGE_PRESETS.hero.fit
								})}
								srcset={generateCFSrcSet(leadImage, CF_IMAGE_PRESETS.hero.widths, CF_IMAGE_PRESETS.hero.quality, CF_IMAGE_PRESETS.hero.format)}
								sizes="(min-width: 1320px) 1240px, (min-width: 1024px) calc(100vw - 80px), (min-width: 640px) calc(100vw - 48px), calc(100vw - 32px)"
								alt={leadTune.data.title}
								width="1360"
								height="583"
								loading="eager"
								fetchpriority="high"
								decoding="sync"
								class="w-full aspect-[16/10] sm:aspect-[21/9] object-cover"
							/>
						</figure>
					</a>
				)}
				<h2 class="mt-6 text-[1.75rem] sm:text-[2.5rem] leading-[1.06] font-extrabold" style="letter-spacing: -0.035em;">
					<a href={leadUrl} class="no-underline text-on-surface hover:text-[var(--color-secondary)] transition-colors">
						{leadTune.data.title}
					</a>
				</h2>
				{leadTune.data.description && (
					<p class="mt-2.5 text-base text-on-surface-variant leading-normal">
						{leadTune.data.description}
					</p>
				)}
				<p class="rubric mt-3.5 flex flex-wrap items-center gap-x-1.5">
					<FormattedDate date={leadTune.data.pubDate} />
					{leadMinutes && (
						<>
							<span aria-hidden="true">&middot;</span>
							<span>{leadMinutes}</span>
						</>
					)}
					<span aria-hidden="true">&middot;</span>
					<span>AI-generated</span>
				</p>
				{leadCovers.length > 0 && (
					<div class="mt-4 grid grid-cols-4 sm:grid-cols-8 gap-1.5">
						{leadCovers.map(cover => (
							<img
								src={getCFImageUrl(cover.src, { width: 160, quality: 60 })}
								alt={cover.alt}
								width="80"
								height="80"
								loading="lazy"
								decoding="async"
								class="w-full aspect-square object-cover rounded-[3px]"
							/>
						))}
					</div>
				)}
				<p class="rubric mt-3">
					The records themselves live at <a href="https://www.russ.fm/" class="no-underline text-on-surface hover:text-[var(--color-secondary)]">russ.fm</a>
					{lastfmUrl && <> &middot; <a href={lastfmUrl} class="no-underline text-on-surface hover:text-[var(--color-secondary)]">Last.fm</a></>}
					{discogsUrl && <> &middot; <a href={discogsUrl} class="no-underline text-on-surface hover:text-[var(--color-secondary)]">Discogs</a></>}
				</p>
			</article>
		)}

		{previousWeeks.length > 0 && (
			<>
				<div class="pt-14"><p class="home-section-title" role="heading" aria-level="2">Previous weeks</p></div>
				<div class="feed">
					{previousWeeks.map((tune) => (
						<div data-reveal>
							<PostCard post={tune} headingLevel="3" />
						</div>
					))}
				</div>
			</>
		)}

		<Pagination
			currentPage={1}
			totalPages={totalPages}
			getHref={(pageNum) => (pageNum === 1 ? '/tunes/' : `/tunes/page/${pageNum}/`)}
			olderLabel="Older weeks"
			newerLabel="Newer weeks"
		/>
	</section>
</BaseLayout>

<style>
	.tunes-tabs {
		display: flex;
		align-items: center;
		gap: 1.75rem;
		margin-top: 0.5rem;
		border-bottom: 1px solid var(--color-outline-variant);
		overflow-x: auto;
		scrollbar-width: none;
	}

	.tunes-tabs::-webkit-scrollbar {
		display: none;
	}

	.tunes-tabs a {
		padding: 1.125rem 0 1rem;
		font-size: 0.875rem;
		color: var(--color-on-surface-variant);
		border-bottom: 1px solid transparent;
		margin-bottom: -1px;
		white-space: nowrap;
		text-decoration: none;
	}

	.tunes-tabs a:hover {
		color: var(--color-on-surface);
	}

	.tunes-tabs a[aria-current='page'] {
		color: var(--color-on-surface);
		border-bottom-color: var(--color-on-surface);
	}

	.tab-count {
		font-size: 0.75rem;
		margin-left: 0.2rem;
		opacity: 0.75;
	}

	@media (max-width: 640px) {
		.tunes-tabs {
			-webkit-mask-image: linear-gradient(to right, black 88%, transparent);
			mask-image: linear-gradient(to right, black 88%, transparent);
		}
	}
</style>
