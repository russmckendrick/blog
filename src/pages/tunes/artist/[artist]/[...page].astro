---
import { getCollection } from 'astro:content'
import type { CollectionEntry } from 'astro:content'
import type { GetStaticPaths } from 'astro'
import BaseLayout from '../../../../layouts/BaseLayout.astro'
import PostCard from '../../../../components/blog/PostCard.astro'
import Pagination from '../../../../components/layout/Pagination.astro'
import { Schema } from 'astro-seo-schema'
import {
  tunesIndex,
  getArtistBySlug,
  getAlbumsByArtist,
  getArtistTuneUrl,
  getAlbumTuneUrl
} from '../../../../utils/tunes-index'
import {
  createCollectionPageSchema,
  createBreadcrumbSchema,
  createMusicGroupSchema
} from '../../../../utils/schema'

export const getStaticPaths = (async ({ paginate }) => {
  const allTunes = (await getCollection('tunes'))
    .filter((tune) => import.meta.env.DEV || !tune.data.draft)

  const paths = []
  for (const artist of tunesIndex.artists) {
    const postUrls = new Set(artist.posts.map((p) => p.url))
    const tunes = allTunes
      .filter((tune) => {
        const date = tune.data.pubDate
        const year = date.getFullYear().toString()
        const month = String(date.getMonth() + 1).padStart(2, '0')
        const day = String(date.getDate()).padStart(2, '0')
        const slug = tune.data.title
          .toLowerCase()
          .replace(/[^a-z0-9\s-]/g, '')
          .replace(/\s+/g, '-')
          .replace(/-+/g, '-')
          .trim()
          .replace(/^-+|-+$/g, '')
        return postUrls.has(`/${year}/${month}/${day}/${slug}/`)
      })
      .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())

    if (tunes.length === 0) continue

    paths.push(
      ...paginate(tunes, {
        params: { artist: artist.slug },
        pageSize: 9
      })
    )
  }
  return paths
}) satisfies GetStaticPaths

const { page } = Astro.props
const { artist: artistSlug } = Astro.params

const artist = getArtistBySlug(artistSlug!)
if (!artist) {
  return new Response(null, { status: 404, statusText: 'Artist not found' })
}

const albums = getAlbumsByArtist(artist.slug)
const siteUrl = Astro.site?.toString() || 'https://www.russ.cloud/'
const pageUrl = new URL(Astro.url.pathname, Astro.site).toString()

const title = `Tunes featuring ${artist.name}`
const description = `${artist.name} appears in ${artist.postCount} weekly Listened to This Week post${
  artist.postCount !== 1 ? 's' : ''
} on russ.cloud across ${artist.albumCount} album${
  artist.albumCount !== 1 ? 's' : ''
}. Browse the posts and the records that featured them.`

const collectionSchema = createCollectionPageSchema({
  name: title,
  description,
  url: pageUrl,
  items: page.data.map((tune: CollectionEntry<'tunes'>) => {
    const date = tune.data.pubDate
    const year = date.getFullYear().toString()
    const month = String(date.getMonth() + 1).padStart(2, '0')
    const day = String(date.getDate()).padStart(2, '0')
    const slug = tune.data.title
      .toLowerCase()
      .replace(/[^a-z0-9\s-]/g, '')
      .replace(/\s+/g, '-')
      .replace(/-+/g, '-')
      .trim()
      .replace(/^-+|-+$/g, '')
    return {
      name: tune.data.title,
      url: new URL(`/${year}/${month}/${day}/${slug}/`, siteUrl).toString()
    }
  }),
  numberOfItems: page.total
})

const breadcrumbSchema = createBreadcrumbSchema(
  [
    { name: 'Home', url: '/' },
    { name: 'Tunes', url: '/tunes/' },
    { name: 'Artists', url: '/tunes/artist/' },
    { name: artist.name, url: getArtistTuneUrl(artist.slug) }
  ],
  siteUrl
)

const musicGroupSchema = createMusicGroupSchema({
  name: artist.name,
  url: pageUrl,
  image: artist.image ? new URL(artist.image, siteUrl).toString() : undefined,
  sameAs: artist.artistUrl ? [artist.artistUrl] : undefined
})
---

<BaseLayout title={title} description={description} image={`/tunes/artist/${artist.slug}-og.png`}>
  <Schema slot="head" item={collectionSchema} />
  <Schema slot="head" item={breadcrumbSchema} />
  <Schema slot="head" item={musicGroupSchema} />

  <section class="max-w-[728px] mx-auto px-6">
    <header class="pt-8 pb-8 border-b" style="border-color: var(--color-outline-variant);" data-entrance>
      <p class="mb-4">
        <a href="/tunes/artist/" class="rubric nav-underline no-underline hover:text-on-surface">&larr; All artists</a>
      </p>
      <h1>{artist.name}</h1>
      <p class="mt-3 text-lg text-on-surface-variant leading-normal">
        {artist.postCount} weekly post{artist.postCount !== 1 ? 's' : ''} · {artist.albumCount} album{artist.albumCount !== 1 ? 's' : ''} featured
      </p>
      {artist.artistUrl && (
        <p class="rubric mt-3">
          More on the music site:
          {' '}<a class="text-on-surface no-underline hover:text-[var(--color-secondary)]" href={artist.artistUrl} rel="noopener noreferrer" target="_blank">{artist.artistUrl.replace(/^https?:\/\//, '')}</a>
        </p>
      )}
    </header>

    {albums.length > 0 && (
      <section class="pt-8 pb-8 border-b" style="border-color: var(--color-outline-variant);">
        <p class="text-[15px] font-semibold" style="letter-spacing: -0.01em;" role="heading" aria-level="2">
          Albums by {artist.name}
        </p>
        <ul class="mt-3 flex flex-wrap gap-2">
          {albums.map((album) => (
            <li>
              <a href={getAlbumTuneUrl(album.slug)} class="tag-editorial">
                {album.name}
                <span class="opacity-70">{album.posts.length}×</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <h2 class="sr-only">Posts featuring {artist.name}</h2>
    <div class="feed">
      {page.data.map((tune: CollectionEntry<'tunes'>) => (
        <div data-reveal>
          <PostCard post={tune} headingLevel="3" />
        </div>
      ))}
    </div>

    {page.total > page.size && (
      <Pagination
        currentPage={page.currentPage}
        totalPages={page.lastPage}
        getHref={(pageNum) => (pageNum === 1 ? `/tunes/artist/${artist.slug}/` : `/tunes/artist/${artist.slug}/${pageNum}/`)}
        hideIfSingle={false}
        olderLabel="Older weeks"
        newerLabel="Newer weeks"
      />
    )}
  </section>
</BaseLayout>
