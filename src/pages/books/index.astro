---
import { getCollection } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { Schema } from 'astro-seo-schema'
import {
  createBookSchema,
  createCollectionPageSchema,
  createBreadcrumbSchema
} from '../../utils/schema'
import { AUTHOR_NAME } from '../../consts'
import { getCFImageUrl } from '../../utils/cloudflare-images'

const siteUrl = Astro.site?.toString() || 'https://www.russ.cloud/'
const pageUrl = new URL(Astro.url.pathname, Astro.site).toString()

const allBooks = await getCollection('books', ({ data }) => !data.draft)
// Newest first: the latest book is featured, the rest fill the shelf
const books = allBooks.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
const [featured, ...shelf] = books
const years = books.map((book) => book.data.year ?? book.data.pubDate.getFullYear())
const firstYear = Math.min(...years)
const lastYear = Math.max(...years)
const publishers = [...new Set(books.map((book) => book.data.publisher))]
const topics = [...new Set(books.map((book) => book.data.topic).filter(Boolean))]
const listFormat = new Intl.ListFormat('en-GB', { style: 'long', type: 'conjunction' })
const coverSrc = (cover: string, width: number) => getCFImageUrl(cover, { width, quality: 70, format: 'auto' })

const title = `Books by ${AUTHOR_NAME}`
const description = `${books.length} technical books written or co-authored by ${AUTHOR_NAME}, covering Docker, Kubernetes, Ansible, Infrastructure as Code, and serverless on Packt Publishing and The New Stack.`

const collectionSchema = createCollectionPageSchema({
  name: title,
  description,
  url: pageUrl,
  items: books.map((book) => ({
    name: book.data.title,
    url: new URL(`/books/${book.id}/`, siteUrl).toString()
  })),
  numberOfItems: books.length
})

const breadcrumbSchema = createBreadcrumbSchema(
  [
    { name: 'Home', url: '/' },
    { name: 'Books', url: '/books/' }
  ],
  siteUrl
)

const bookSchemas = books.map((book) =>
  createBookSchema({
    name: book.data.title,
    author: AUTHOR_NAME,
    url: new URL(`/books/${book.id}/`, siteUrl).toString(),
    image: new URL(book.data.cover, siteUrl).toString(),
    sameAs: book.data.buyLink ? [book.data.buyLink] : undefined,
    publisher: book.data.publisher
  })
)
---

<BaseLayout title={title} description={description}>
  <Schema slot="head" item={collectionSchema} />
  <Schema slot="head" item={breadcrumbSchema} />
  {bookSchemas.map((schema) => (
    <Schema slot="head" item={schema} />
  ))}

  <section class="page-frame pb-16">
    <header class="page-head" data-entrance>
      <h1>Books</h1>
      <p class="page-lede">
        {books.length} technical books on {listFormat.format(topics as string[])}, written or co-authored between {firstYear} and {lastYear} for {listFormat.format(publishers)}.
      </p>
    </header>

    {featured && (
      <article class="book-feature" data-entrance>
        <a href={`/books/${featured.id}/`} class="book-feature-cover" tabindex="-1" aria-hidden="true" aria-label={featured.data.title}>
          <img
            src={coverSrc(featured.data.cover, 640)}
            alt=""
            width="320"
            height="395"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </a>
        <div class="book-feature-body">
          <p class="rubric"><span class="book-feature-label">Latest book</span> · {featured.data.year ?? featured.data.pubDate.getFullYear()} · {featured.data.publisher}</p>
          <h2 class="book-feature-title"><a href={`/books/${featured.id}/`}>{featured.data.title}</a></h2>
          <p class="book-feature-desc">{featured.data.description}</p>
          <div class="book-feature-actions">
            <a href={`/books/${featured.id}/`} class="book-btn book-btn--ink">About the book</a>
            {featured.data.buyLink && (
              <a href={featured.data.buyLink} class="book-btn" target="_blank" rel="noopener noreferrer">Buy from {featured.data.publisher.replace(' Publishing', '')} ↗</a>
            )}
          </div>
        </div>
      </article>
    )}

    <div class="pt-16 lg:pt-24 pb-8"><h2 class="home-section-title">The whole shelf</h2></div>
    <ul class="book-shelf" role="list">
      {shelf.map((book) => (
        <li>
          <a href={`/books/${book.id}/`} class="book-card">
            <img
              src={coverSrc(book.data.cover, 400)}
              alt={book.data.alt}
              width="200"
              height="247"
              loading="lazy"
              decoding="async"
              class="book-card-cover"
            />
            <span class="rubric book-card-meta">{book.data.year ?? book.data.pubDate.getFullYear()}{book.data.topic && <> · {book.data.topic}</>}</span>
            <span class="book-card-title">{book.data.title}</span>
          </a>
        </li>
      ))}
    </ul>

    <p class="rubric mt-14">
      More on the author behind these books:{' '}
      <a class="underline hover:text-on-surface" href="/about/">about page</a>{' '}·{' '}
      <a class="underline hover:text-on-surface" href="/author/russ-mckendrick/">post archive</a>.
    </p>
  </section>
</BaseLayout>

<style>
  .book-feature {
    display: grid;
    gap: 1.75rem;
    margin-top: 2.5rem;
    padding: 1.5rem;
    border-radius: 22px;
    background-color: var(--paper-well);
  }

  @media (min-width: 768px) {
    .book-feature {
      grid-template-columns: 280px minmax(0, 1fr);
      gap: 3rem;
      align-items: center;
      padding: 2.5rem;
    }
  }

  @media (min-width: 1024px) {
    .book-feature {
      grid-template-columns: 320px minmax(0, 1fr);
      gap: 4rem;
      padding: 3.5rem;
    }
  }

  .book-feature-cover {
    display: block;
    max-width: 260px;
  }

  @media (min-width: 768px) {
    .book-feature-cover {
      max-width: none;
    }
  }

  .book-feature-cover img,
  .book-card-cover {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 81 / 100;
    object-fit: cover;
    border-radius: 8px;
    background-color: var(--color-surface);
    box-shadow: 0 24px 40px -28px rgba(10, 10, 20, 0.45);
  }

  .book-feature-label {
    color: var(--accent);
    font-weight: 600;
  }

  .book-feature-title {
    margin: 0.75rem 0 0;
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    line-height: 1.06;
    font-weight: 800;
    letter-spacing: -0.035em;
  }

  .book-feature-title a {
    color: var(--color-on-surface);
    text-decoration: none;
  }

  .book-feature-title a:hover {
    color: var(--accent);
  }

  .book-feature-desc {
    margin-top: 1rem;
    max-width: 620px;
    font-size: 1.125rem;
    line-height: 1.55;
    color: var(--color-on-surface-variant);
  }

  .book-feature-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .book-btn {
    display: inline-flex;
    align-items: center;
    height: 44px;
    padding: 0 1.25rem;
    border-radius: 10px;
    border: 1px solid var(--rule-strong);
    background-color: var(--color-surface);
    color: var(--color-on-surface);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
  }

  .book-btn:hover {
    color: var(--color-on-surface);
    border-color: var(--color-on-surface-variant);
  }

  .book-btn--ink {
    background-color: var(--color-on-surface);
    border-color: var(--color-on-surface);
    color: var(--color-surface);
  }

  .book-btn--ink:hover {
    color: var(--color-surface);
    opacity: 0.88;
  }

  .book-shelf {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.5rem 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 640px) {
    .book-shelf {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2.5rem 2rem;
    }
  }

  @media (min-width: 1024px) {
    .book-shelf {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }

  .book-card {
    display: flex;
    flex-direction: column;
    color: var(--color-on-surface);
    text-decoration: none;
  }

  .book-card-meta {
    margin-top: 1rem;
  }

  .book-card-title {
    margin-top: 0.25rem;
    font-size: 1rem;
    line-height: 1.3;
    font-weight: 700;
    letter-spacing: -0.015em;
    transition: color var(--dur-quick) ease;
  }

  .book-card:hover .book-card-title {
    color: var(--accent);
  }

  .book-card:hover .book-card-cover {
    opacity: 0.9;
  }
</style>
