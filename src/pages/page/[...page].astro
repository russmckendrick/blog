---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/blog/PostCard.astro';
import TagTabs from '../../components/home/TagTabs.astro';
import Pagination from '../../components/layout/Pagination.astro';
import { HOME_PAGE_SIZE, PAGINATION_PAGE_SIZE } from '../../consts';
import { Schema } from 'astro-seo-schema';
import { createCollectionPageSchema } from '../../utils/schema';
import { getPostUrl } from '../../utils/url';

export const getStaticPaths = (async () => {
	const allPosts = (await getCollection('blog'))
		.filter(post => import.meta.env.DEV || !post.data.draft)
		.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

	// The homepage shows HOME_PAGE_SIZE rows, so exclude them from pagination
	const paginatedPosts = allPosts.slice(HOME_PAGE_SIZE);
	const totalPaginatedPages = Math.ceil(paginatedPosts.length / PAGINATION_PAGE_SIZE);

	// Generate paths starting at page 2 (homepage is page 1)
	return Array.from({ length: totalPaginatedPages }, (_, i) => ({
		params: { page: String(i + 2) },
		props: {
			page: {
				data: paginatedPosts.slice(i * PAGINATION_PAGE_SIZE, (i + 1) * PAGINATION_PAGE_SIZE),
				currentPage: i + 2,
				lastPage: totalPaginatedPages + 1,
				size: PAGINATION_PAGE_SIZE,
				total: paginatedPosts.length,
			}
		}
	}));
}) satisfies GetStaticPaths;

const { page } = Astro.props;

const siteUrl = Astro.site?.toString() || 'https://www.russ.cloud/';
const description = `Page ${page.currentPage} of every post on Russ.Cloud, newest first: DevOps, AI coding tools, Rust CLIs, macOS and Linux, written by Russ McKendrick since 2013.`;
const collectionSchema = createCollectionPageSchema({
	name: `Writing, page ${page.currentPage}`,
	description,
	url: new URL(Astro.url.pathname, siteUrl).toString(),
	items: page.data.map((post) => ({ name: post.data.title, url: new URL(getPostUrl(post.data.pubDate, post.data.title), siteUrl).toString() })),
	numberOfItems: page.total
});
---

<BaseLayout
	title={`Writing, page ${page.currentPage} of ${page.lastPage}`}
	description={description}
>
	<Schema slot="head" item={collectionSchema} />
	<section class="page-frame">
		<header class="page-head !border-b-0 !pb-2" data-entrance>
			<h1>Writing</h1>
			<p class="page-lede">Every post, newest first — page {page.currentPage} of {page.lastPage}.</p>
		</header>

		<TagTabs active="latest" />

		<div class="feed">
			{page.data.map((post, index) => (
				<div data-reveal>
					<PostCard post={post} priority={index < 2} headingLevel="2" />
				</div>
			))}
		</div>

		{page.total > page.size && (
			<Pagination
				currentPage={page.currentPage}
				totalPages={page.lastPage}
				getHref={(pageNum) => (pageNum === 1 ? '/' : `/page/${pageNum}/`)}
				hideIfSingle={false}
			/>
		)}
	</section>
</BaseLayout>
