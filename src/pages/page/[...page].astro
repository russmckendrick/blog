---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/blog/PostCard.astro';
import TagTabs from '../../components/home/TagTabs.astro';
import Pagination from '../../components/layout/Pagination.astro';
import { SITE_TITLE, SITE_DESCRIPTION, HOME_PAGE_SIZE, PAGINATION_PAGE_SIZE } from '../../consts';

export const getStaticPaths = (async () => {
	const allPosts = (await getCollection('blog'))
		.filter(post => import.meta.env.DEV || !post.data.draft)
		.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

	// The homepage shows HOME_PAGE_SIZE rows, so exclude them from pagination
	const paginatedPosts = allPosts.slice(HOME_PAGE_SIZE);
	const totalPaginatedPages = Math.ceil(paginatedPosts.length / PAGINATION_PAGE_SIZE);

	// Generate paths starting at page 2 (homepage is page 1)
	return Array.from({ length: totalPaginatedPages }, (_, i) => ({
		params: { page: String(i + 2) },
		props: {
			page: {
				data: paginatedPosts.slice(i * PAGINATION_PAGE_SIZE, (i + 1) * PAGINATION_PAGE_SIZE),
				currentPage: i + 2,
				lastPage: totalPaginatedPages + 1,
				size: PAGINATION_PAGE_SIZE,
				total: paginatedPosts.length,
			}
		}
	}));
}) satisfies GetStaticPaths;

const { page } = Astro.props;
---

<BaseLayout title={`${SITE_TITLE} - Page ${page.currentPage}`} description={SITE_DESCRIPTION}>
	<section class="max-w-[728px] mx-auto px-6">
		<h1 class="sr-only">{SITE_TITLE} - Page {page.currentPage}</h1>

		<TagTabs active="latest" />

		<div class="feed">
			{page.data.map((post, index) => (
				<div data-reveal>
					<PostCard post={post} priority={index < 2} headingLevel="2" />
				</div>
			))}
		</div>

		{page.total > page.size && (
			<Pagination
				currentPage={page.currentPage}
				totalPages={page.lastPage}
				getHref={(pageNum) => (pageNum === 1 ? '/' : `/page/${pageNum}/`)}
				hideIfSingle={false}
			/>
		)}
	</section>
</BaseLayout>
