---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTagMetadata, getTagName, getTagUrl, normalizeTagSlug } from '../../utils/tags';
import { getAvatarImageUrl } from '../../utils/avatars';
import { getPostUrl } from '../../utils/url';
import { TAG_AVATAR_MAP } from '../../consts';

// Get all blog posts, newest first, and tally tags
const posts = (await getCollection('blog'))
  .filter(post => import.meta.env.DEV || !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Count posts per tag (normalised slug) and remember each tag's newest post
const tagStats = new Map<string, { count: number; latest: (typeof posts)[number] }>();
for (const post of posts) {
  for (const tag of post.data.tags || []) {
    const slug = normalizeTagSlug(tag);
    const stats = tagStats.get(slug);
    if (stats) stats.count += 1;
    else tagStats.set(slug, { count: 1, latest: post });
  }
}

// Most-written-about first; ties alphabetical
const tags = Array.from(tagStats.entries())
  .map(([slug, { count, latest }]) => ({
    slug,
    count,
    metadata: getTagMetadata(slug),
    avatar: TAG_AVATAR_MAP[slug] ? getAvatarImageUrl(`/images/avatars/${TAG_AVATAR_MAP[slug]}`, 48) : undefined,
    latest: { title: latest.data.title, href: getPostUrl(latest.data.pubDate, latest.data.title) },
  }))
  .sort((a, b) => b.count - a.count || a.metadata.title.localeCompare(b.metadata.title));
---

<BaseLayout
  title="Tags"
  description="Browse all tags and topics covered on this blog"
>
  <section class="page-frame pb-16">
    <header class="page-head" data-entrance>
      <h1>Tags</h1>
      <p class="page-lede">
        {tags.length} topics across {posts.length} posts, most written about first.
      </p>
    </header>

    <ul class="tag-grid" role="list">
      {tags.map((tag) => (
        <li class="tag-card">
          <a href={getTagUrl(tag.slug)} class="tag-card-link">
            {tag.avatar ? (
              <img src={tag.avatar} alt="" width="48" height="48" loading="lazy" decoding="async" class="tag-card-avatar" />
            ) : (
              <span class="tag-card-avatar tag-card-avatar--blank" aria-hidden="true">#</span>
            )}
            <span class="tag-card-head">
              <span class="tag-card-name">{getTagName(tag.slug)}</span>
              <span class="rubric">{tag.count} post{tag.count === 1 ? '' : 's'}</span>
            </span>
            <span class="tag-card-desc">{tag.metadata.description}</span>
          </a>
          <p class="tag-card-latest">
            <span class="rubric">Latest</span>
            <a href={tag.latest.href}>{tag.latest.title}</a>
          </p>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  .tag-grid {
    display: grid;
    gap: 1rem;
    margin: 2.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 640px) {
    .tag-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .tag-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 1280px) {
    .tag-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .tag-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--rule);
    border-radius: 16px;
    transition: border-color var(--dur-quick) ease, background-color var(--dur-quick) ease;
  }

  .tag-card:hover {
    border-color: var(--rule-strong);
    background-color: var(--paper-well);
  }

  .tag-card-link {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr);
    gap: 0.75rem 1rem;
    align-items: center;
    padding: 1.25rem 1.25rem 0.875rem;
    color: var(--color-on-surface);
    text-decoration: none;
    flex-grow: 1;
  }

  .tag-card-link:hover {
    color: var(--color-on-surface);
  }

  .tag-card-avatar {
    width: 48px;
    height: 48px;
    border-radius: 9999px;
    object-fit: cover;
    background-color: var(--paper-well);
  }

  .tag-card-avatar--blank {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--color-on-surface-variant);
  }

  .tag-card:hover .tag-card-avatar {
    background-color: var(--color-surface);
  }

  .tag-card-head {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .tag-card-name {
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.25;
    transition: color var(--dur-quick) ease;
  }

  .tag-card-link:hover .tag-card-name {
    color: var(--accent);
  }

  .tag-card-desc {
    grid-column: 1 / -1;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-on-surface-variant);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .tag-card-latest {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    margin: 0 1.25rem 1.25rem;
    padding-top: 0.875rem;
    border-top: 1px solid var(--rule);
    font-size: 0.875rem;
    line-height: 1.4;
  }

  .tag-card-latest a {
    color: var(--color-on-surface);
    font-weight: 600;
    text-decoration: none;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .tag-card-latest a:hover {
    color: var(--accent);
  }
</style>
