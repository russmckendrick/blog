---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Pagination from '../../components/layout/Pagination.astro'
import ReadingList from '../../components/reading/ReadingList.astro'
import ReadingHeader from '../../components/reading/ReadingHeader.astro'
import readingData from '../../data/reading-filtered'
import { Schema } from 'astro-seo-schema'
import { createCollectionPageSchema } from '../../utils/schema'

const ITEMS_PER_PAGE = 30

const totalPages = Math.max(1, Math.ceil(readingData.length / ITEMS_PER_PAGE))
const items = readingData.slice(0, ITEMS_PER_PAGE)

// Collect all unique tags with counts across the full dataset
const tagCounts = new Map<string, number>()
for (const item of readingData) {
  for (const tag of (item as any).tags || []) {
    tagCounts.set(tag, (tagCounts.get(tag) || 0) + 1)
  }
}

const title = 'Reading List'
const description = 'Articles I have saved on Instapaper this year, newest first and grouped by month: AI, security, cloud and the odd essay, each linking to the original.'
const collectionSchema = createCollectionPageSchema({
  name: 'Reading list',
  description,
  url: new URL('/reading/', Astro.site).toString(),
  items: items.map((item) => ({ name: item.title, url: item.url })),
  numberOfItems: readingData.length
})
---

<BaseLayout title={title} description={description}>
  <Schema slot="head" item={collectionSchema} />
  <section class="page-frame pb-16">
    <ReadingHeader totalArticles={readingData.length} tagCounts={tagCounts} />
    <ReadingList items={items} />

    {totalPages > 1 && (
      <Pagination
        currentPage={1}
        totalPages={totalPages}
        getHref={(pageNum) => (pageNum === 1 ? '/reading/' : `/reading/page/${pageNum}/`)}
        hideIfSingle={true}
        olderLabel="Older articles"
        newerLabel="Newer articles"
      />
    )}
  </section>
</BaseLayout>
