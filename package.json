{
  "name": "russ-cloud",
  "type": "module",
  "version": "1.0.0",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/generate-llms-markdown.js",
    "preview": "astro preview",
    "preview:worker": "astro build && wrangler dev",
    "astro": "astro",
    "post": "node scripts/new-post.js",
    "tunes": "node scripts/generate-tunes-post.js",
    "wrapped": "node scripts/generate-year-wrapped.js",
    "backfill-tunes-images": "node scripts/backfill-tunes-images.js",
    "rebuild-artist-usage": "node scripts/rebuild-tunes-artist-usage.js",
    "rebuild-image-history": "node scripts/rebuild-tunes-image-history.js",
    "check-artist-reuse": "node scripts/check-tunes-artist-reuse.js",
    "sync-portrait-alt": "node scripts/sync-tunes-portrait-alt.js",
    "medium": "node scripts/publish-to-medium.js",
    "reading": "node scripts/fetch-reading-list.js",
    "reading-images": "node scripts/fetch-reading-list.js && node scripts/cache-reading-images.js --force --limit 10",
    "optimize": "node scripts/optimize-images.js",
    "analyze-links": "node scripts/analyze-internal-links.js",
    "extract-colors": "node scripts/extract-hero-colors.js",
    "generate-logo": "node scripts/generate-logo.js",
    "build-tunes-index": "node scripts/build-tunes-index.js",
    "prebuild": "pnpm run extract-colors && node scripts/cache-link-preview-images.js && node scripts/fetch-reading-list.js && node scripts/build-tunes-index.js",
    "cache-link-previews": "node scripts/cache-link-preview-images.js",
    "refresh-link-previews": "node scripts/cache-link-preview-images.js --refresh-stale",
    "cache-reading-images": "node scripts/cache-reading-images.js",
    "refresh-reading-images": "node scripts/cache-reading-images.js --refresh-stale",
    "preinstall": "npx only-allow pnpm"
  },
  "dependencies": {
    "@astro-community/astro-embed-link-preview": "^0.3.1",
    "@astro-community/astro-embed-youtube": "^0.5.10",
    "@astrojs/check": "^0.9.12",
    "@astrojs/mdx": "^8.1.1",
    "@astrojs/react": "^7.1.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@casoon/astro-webvitals": "^0.4.10",
    "@fal-ai/client": "^1.10.1",
    "@iconify-json/tabler": "^1.2.42",
    "@langchain/langgraph": "^1.5.2",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@takumi-rs/core": "^2.17.1",
    "@takumi-rs/helpers": "^2.17.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.4.2",
    "astro-expressive-code": "^0.44.3",
    "astro-icon": "^1.2.0",
    "astro-pagefind": "^2.0.1",
    "astro-seo-plugin": "^1.3.7",
    "astro-seo-schema": "^7.0.1",
    "axios": "^1.20.0",
    "exa-js": "^2.26.0",
    "gray-matter": "^4.0.3",
    "js-yaml": "^5.5.0",
    "langchain": "^1.5.19",
    "lightgallery": "^3.0.0",
    "linkedom": "^0.18.14",
    "mermaid": "^12.2.0",
    "oauth-1.0a": "^2.2.6",
    "openai": "catalog:",
    "pagefind": "^1.5.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanitize-html": "^2.18.1",
    "schema-dts": "^2.1.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@astrojs/markdown-remark": "7.3.3",
    "@iconify-json/simple-icons": "^1.2.100",
    "@langchain/anthropic": "^1.6.0",
    "@langchain/core": "^1.3.0",
    "@langchain/openai": "^1.7.0",
    "@types/hast": "^3.0.5",
    "@types/sanitize-html": "^2.16.2",
    "dotenv": "^18.0.9",
    "fast-glob": "^3.3.3",
    "opentype.js": "^2.0.0",
    "puppeteer": "^25.16.0",
    "wrangler": "^4.152.0"
  }
}
